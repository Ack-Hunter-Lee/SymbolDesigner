<UserControl
    x:Class="SymbolDesigner.Views.SymbolDesignerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SymbolDesigner.Controls"
    xmlns:conv="clr-namespace:SymbolDesigner.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:SymbolDesigner.Models"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:viewmodels="clr-namespace:SymbolDesigner.ViewModels"
    xmlns:views="clr-namespace:SymbolDesigner.Views"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  布尔→可见性转换器（局部定义，避免依赖外部资源）  -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <controls:IntEqualsConverter x:Key="IntEquals" />
        <conv:SubtractConverter x:Key="SubSix" />
        <conv:HalveConverter x:Key="Halve" />
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:FileNameOnlyConverter x:Key="FileNameOnly" />
        <conv:TagToBrushesConverter x:Key="TagBrush" />
        <conv:PickCenterBrushConverter x:Key="PickCenterBrush" />
        <conv:KeyEqualsActiveConverter x:Key="KeyActive" />
        <conv:InverseScaleConverter x:Key="InvScale" />
        <conv:DivideByScaleConverter x:Key="DivByScale" />
        <!-- 枚举相等比较（RadioButton 列表用：当前枚举值 == 该 RadioButton 代表的枚举值 → 选中） -->
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter" />
        <!--  BandOutlineBuilder 为静态工具类，不再需要 XAML 实例  -->

        <!--
            顶部工具栏的样式资源（图标化 + 多行布局用）。
            风格向 VS Code 看齐：图标按钮无边框、无背景（hover/selected 才显背景层）。
            复合控件 / 信息条独立样式，保留细描边以承载数值控件。
            Tag 约定：纯图标按钮 Tag="bg,border,fg"（三个颜色，逗号分隔，#RRGGBB）；
            复合控件 / 信息条 Tag="bg,border"（前景色由内嵌控件决定）。
            Tag 由 TagToBrushesConverter 拆解成 Brush[3] → Style 通过 Self binding 取 idx。
        -->
        <!--
            通用图标按钮：VS Code 风格——无固定方框、无永久描边，仅由 Padding 提供点击命中区。
            hover 时 Border 自身背景浮一层 #1F2A36（中性蓝灰，0.6 不透明）作为视觉反馈；
            选中态（VM/上级选中"工具"按钮）由 KeyEqualsActiveConverter 通过 inline BackgroundSetter 覆盖。
            注：Border 不是 Control，没有 Template 属性——hover 反馈通过 Style Trigger 直接驱动 Background。
        -->
        <Style x:Key="ToolIconButton" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Bg.Hover}" />
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--
            通用复合控件容器：仅在 hover 时浮出背景层，去除默认描边方框。
            内嵌 ComboBox/Slider 等控件仍按自身样式渲染。
        -->
        <Style x:Key="ToolComboButton" TargetType="Border">
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Bg.Hover}" />
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--  信息条（非交互）——保持细描边圆角，承载"当前文件名/元素数"等只读标签。  -->
        <Style x:Key="ToolInfoBadge" TargetType="Border">
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource TagBrush}, ConverterParameter=0}" />
            <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource TagBrush}, ConverterParameter=1}" />
        </Style>
        <!--  视觉分隔条：VS Code 风格的细分隔线（一根 1px 竖线，左右各给一点留白）。  -->
        <Style x:Key="ToolSep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Border.Subtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!--
            图标字符统一样式：Segoe MDL2 Assets 字体 + 16px + 居中。
            Foreground 通过 Self Tag 解析（Tag 第三个颜色，缺位时用默认浅蓝）。
        -->
        <Style x:Key="ToolIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag, Converter={StaticResource TagBrush}, ConverterParameter=2}" />
        </Style>

        <!--
            Ribbon 页签式顶部栏（AutoCAD 风格）样式资源。
            - RibbonTabControl：透明无框 TabControl（梳排 Header 由 TabItem 各自渲染）
            - RibbonTabItem：深色扁平页签，选中时背景与内容区衔接 + 高亮文字
            - RibbonPanel：分组面板容器（半透明深色底 + 细描边圆角 + 右侧留白分隔）
            - RibbonPanelCaption：面板组标题（小号次要色文字）
        -->
        <Style x:Key="RibbonTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="RibbonTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Transparent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="4,4,0,0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.State.AccentBorder}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Bg.Panel}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Tool.HoverNeutral}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonPanel" TargetType="Border">
            <Setter Property="Margin" Value="0,2,8,2" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource Brush.Tool.HoverNeutral}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="RibbonPanelCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="Margin" Value="2,0,2,3" />
        </Style>

        <!--  工具栏图标模板（小尺寸，去外层暗框后更清爽）  -->
        <DataTemplate x:Key="L1RectanglePreview">
            <Rectangle
                Width="16"
                Height="10"
                Fill="{StaticResource Brush.Bg.Transparent}"
                Stroke="{StaticResource Brush.Tool.Icon}"
                StrokeThickness="0.6" />
        </DataTemplate>
        <DataTemplate x:Key="L1EllipsePreview">
            <Ellipse
                Width="14"
                Height="14"
                Fill="{StaticResource Brush.Bg.Transparent}"
                Stroke="{StaticResource Brush.Tool.Icon}"
                StrokeThickness="0.6" />
        </DataTemplate>
        <DataTemplate x:Key="L1LinePreview">
            <!--  与其它形状描边宽度统一为 0.6，颜色 White，8 个工具一列看上去协调。  -->
            <Line
                Width="16"
                Height="14"
                Stroke="{StaticResource Brush.Tool.Icon}"
                StrokeThickness="0.6"
                X1="0"
                X2="16"
                Y1="14"
                Y2="0" />
        </DataTemplate>
        <DataTemplate x:Key="L1PolylinePreview">
            <!--  纯折线 Polyline 预览：两段折线，描边与形状类统一 0.6。  -->
            <Polyline
                Points="0,12 6,1 10,7 16,3"
                Stroke="{StaticResource Brush.Tool.Icon}"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="0.6" />
        </DataTemplate>
        <DataTemplate x:Key="L1BandPolylinePreview">
            <!--
                带状折线 BandPolyline 预览：与 Polyline 同形，描边加粗示意"带宽"语义。
                颜色与其他描边统一为 White，避免突兀暗色；宽度 1.2（形状类的 2x）保持可识别。
            -->
            <Path
                Data="M 0,12 L 6,1 L 10,7 L 16,3"
                Stroke="{StaticResource Brush.Tool.Icon}"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="1.2" />
        </DataTemplate>
        <DataTemplate x:Key="L1RoundedPreview">
            <Border
                Width="16"
                Height="10"
                Background="{StaticResource Brush.Bg.Transparent}"
                BorderBrush="{StaticResource Brush.Tool.Icon}"
                BorderThickness="0.6"
                CornerRadius="3" />
        </DataTemplate>
        <DataTemplate x:Key="L1TrianglePreview">
            <Polygon
                Fill="{StaticResource Brush.Bg.Transparent}"
                Points="8,1 15,12 1,12"
                Stroke="{StaticResource Brush.Tool.Icon}"
                StrokeThickness="0.6" />
        </DataTemplate>
        <DataTemplate x:Key="L1RingPreview">
            <!--  圆环预览：14×14 让中央挖空清晰可见  -->
            <Grid Width="14" Height="14">
                <Ellipse
                    Width="14"
                    Height="14"
                    Fill="{StaticResource Brush.Bg.Transparent}"
                    Stroke="{StaticResource Brush.Tool.Icon}"
                    StrokeThickness="0.6" />
                <Ellipse
                    Width="6"
                    Height="6"
                    Fill="{StaticResource Brush.Bg.Canvas}" />
            </Grid>
        </DataTemplate>
        <!--  扇形（Pie）预览：三角形 + 弧边示意扇面  -->
        <DataTemplate x:Key="L1PiePreview">
            <Grid Width="14" Height="14">
                <Path
                    Data="M 7,7 L 14,7 A 7,7 0 0 1 4.95,12.05 Z"
                    Fill="{StaticResource Brush.Bg.Canvas}"
                    Stroke="{StaticResource Brush.Tool.Icon}"
                    StrokeLineJoin="Round"
                    StrokeThickness="0.6" />
            </Grid>
        </DataTemplate>

        <!--  画布渲染模板：每个模板都用 DraggablePrimitive 包裹图形，使图形可在画布上拖动  -->

        <!--
            CAD 风格选中样式（替代已删除的选中虚线框）：
            选中 = 图元自身描边醒目。阵列语义的区分：
            - 影副本（克隆非源位）：选中时描边灰色（弱化，属于阵列投影）
            - 源位置本体（IsArraySourceClone）：选中时亮蓝（突出，可编辑/牵引）
            注意：必须是 Style Setter 提供基础值（不是元素本地属性），
            否则本地值优先级高于 Style.Trigger，选中色不会生效。
        -->
        <Style x:Key="CadShapeSelected" TargetType="Shape">
            <!--
                外观绑定（线条/填充三大组）：Stroke色/粗细/虚线 + 填充画刷。
                不再用触发器改本体颜色——选中标识由 DraggablePrimitive 模板的 SelectionDecor
                上层装饰层提供（浅色填充+描边），保证属性面板调色时画布实时可见。
            -->
            <Setter Property="Stroke" Value="{Binding StrokeBrush}" />
            <Setter Property="Fill" Value="{Binding FillBrush}" />
            <Setter Property="StrokeThickness" Value="{Binding StrokeWidth}" />
            <Setter Property="StrokeDashArray" Value="{Binding StrokeDashArray}" />
            <!--
                圆头端点：斜线段端点在包围盒角上，Flat 平头会让端点看起来像被削平/削尖；
                Round cap 让端点圆润（AutoCAD 默认线端观感），未选中时不显"切角"感。
            -->
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <DataTemplate x:Key="L1RectangleNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive
                Width="{Binding Width}"
                Height="{Binding Height}"
                Opacity="{Binding Opacity}">
                <!--
                    填充/描边全部由 CadShapeSelected 样式按外观属性驱动。
                    不要在本元素写 Fill="Transparent" — 本地值优先级高于 Style Setter，
                    会盖掉用户对 FillStyle/FillColor 的选择（选中后调填充色画布不响应）。
                -->
                <Rectangle
                    Width="{Binding Width}"
                    Height="{Binding Height}"
                    RadiusX="{Binding CornerRadius}"
                    RadiusY="{Binding CornerRadius}"
                    Style="{StaticResource CadShapeSelected}" />
            </views:DraggablePrimitive>
        </DataTemplate>
        <DataTemplate x:Key="L1EllipseNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive
                Width="{Binding Width}"
                Height="{Binding Height}"
                Opacity="{Binding Opacity}">
                <Grid Width="{Binding Width}" Height="{Binding Height}">
                    <!--  椭圆：填充/描边全部由 CadShapeSelected 样式按外观属性驱动。  -->
                    <Ellipse
                        Width="{Binding Width}"
                        Height="{Binding Height}"
                        Style="{StaticResource CadShapeSelected}" />
                    <!--
                        圆心标记（编辑辅助，不导出）：十字提示圆心位置，供重合约束"点选圆心"。
                        Data 以布局框中心 (2,2) 为十字中心 + Width/Height=4 + Center 对齐父 Grid
                        → 几何中心 = 布局框中心 = 圆心，严格重合无偏移。
                        （注意：Path 几何原点 (0,0) 在布局框左上角，不能以 (0,0) 为十字中心，否则整体偏左上。）
                    -->
                    <Path
                        Width="4"
                        Height="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 0,2 L 4,2 M 2,0 L 2,4"
                        IsHitTestVisible="False"
                        Opacity="0.65"
                        Stroke="{StaticResource Brush.Brand.StrokeDim}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="0.4" />
                </Grid>
            </views:DraggablePrimitive>
        </DataTemplate>
        <DataTemplate x:Key="L1LineNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive Opacity="{Binding Opacity}">
                <Grid>
                    <!--
                        兼容 PathData（拖动画线工具产生的 Line 用 Path 渲染，支持任意方向）。
                        只有 LineAxis=Free 时才显示；Horizontal/Vertical 由下面的 Line 几何负责。
                    -->
                    <Path Data="{Binding PathData}" Stretch="None">
                        <Path.Style>
                            <Style BasedOn="{StaticResource CadShapeSelected}" TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PathData, Converter={StaticResource StringNotEmpty}}" Value="True" />
                                            <Condition Binding="{Binding LineAxis}" Value="{x:Static models:LineAxisMode.Free}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <!--  任意斜线（默认）。PathData 非空时由上面 Path 渲染，此处隐藏。  -->
                    <Line
                        X1="0"
                        X2="{Binding Width}"
                        Y1="{Binding Height}"
                        Y2="0">
                        <Line.Style>
                            <Style BasedOn="{StaticResource CadShapeSelected}" TargetType="Line">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PathData, Converter={StaticResource StringNotEmpty}}" Value="False" />
                                            <Condition Binding="{Binding LineAxis}" Value="{x:Static models:LineAxisMode.Free}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Line.Style>
                    </Line>
                    <!--  水平线（Y1=Y2=Height/2）。PathData 非空时由 Path 渲染。  -->
                    <Line
                        X1="0"
                        X2="{Binding Width}"
                        Y1="{Binding Height, Converter={StaticResource Halve}}"
                        Y2="{Binding Height, Converter={StaticResource Halve}}">
                        <Line.Style>
                            <Style BasedOn="{StaticResource CadShapeSelected}" TargetType="Line">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PathData, Converter={StaticResource StringNotEmpty}}" Value="False" />
                                            <Condition Binding="{Binding LineAxis}" Value="{x:Static models:LineAxisMode.Horizontal}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Line.Style>
                    </Line>
                    <!--  竖直线（X1=X2=Width/2）。PathData 非空时由 Path 渲染。  -->
                    <Line
                        X1="{Binding Width, Converter={StaticResource Halve}}"
                        X2="{Binding Width, Converter={StaticResource Halve}}"
                        Y1="0"
                        Y2="{Binding Height}">
                        <Line.Style>
                            <Style BasedOn="{StaticResource CadShapeSelected}" TargetType="Line">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PathData, Converter={StaticResource StringNotEmpty}}" Value="False" />
                                            <Condition Binding="{Binding LineAxis}" Value="{x:Static models:LineAxisMode.Vertical}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Line.Style>
                    </Line>
                </Grid>
            </views:DraggablePrimitive>
        </DataTemplate>
        <!--
            带状折线（带带宽的连贯图形）：按顶点序列向两侧扩张形成闭合轮廓 Path。
            不绑 Width/Height，让 Path 自然撑出超出原始包围盒的带宽轮廓。
            Path.Data 用 MultiBinding 绑 PathData + BandWidth → 任一变化都重新计算轮廓。
        -->
        <DataTemplate x:Key="L1BandPolylineNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive Opacity="{Binding Opacity}">
                <Grid>
                    <!--
                        带带宽的闭合轮廓：OutlineGeometry 由 PathData + Segments 段带宽计算，
                        Segments/PathData 任一变化自动刷新（避免 MultiBinding 的 TypeConverter 坑）。
                        选中时通过 Style 触发器降低 Fill/Stroke opacity（变淡），
                        突出显示下方的原始 Path 中心线（"主角"是 Path）。
                    -->
                    <Path Data="{Binding OutlineGeometry}" Stretch="None">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{Binding StrokeBrush}" />
                                <Setter Property="StrokeThickness" Value="{Binding StrokeWidth}" />
                                <Setter Property="StrokeDashArray" Value="{Binding StrokeDashArray}" />
                                <Setter Property="StrokeLineJoin" Value="Miter" />
                                <!--  填充画刷（FillStyle：无/单色/渐变）。  -->
                                <Setter Property="Fill" Value="{Binding FillBrush}" />
                                <Setter Property="Opacity" Value="1.0" />
                            </Style>
                        </Path.Style>
                    </Path>
                    <!--
                        选中时显示轨迹线（虚线参考），帮助看清顶点位置和折线走向。
                        仅骨架模式下显示；轮廓模式下隐藏（不再强调骨架线）。
                        若任一顶点有圆角半径 > 0，使用 TrajectoryPathData（含 A 命令圆弧）。
                    -->
                    <Path
                        Data="{Binding TrajectoryPathData}"
                        IsHitTestVisible="False"
                        Stretch="None"
                        Stroke="{StaticResource Brush.State.Accent}"
                        StrokeDashArray="2 1.5"
                        StrokeThickness="0.3">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <!--  选中 且 骨架模式 → 显示轨迹线（轮廓模式下隐藏，避免和接缝手柄混淆）  -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                            <Condition Binding="{Binding IsOutlineEditMode}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </views:DraggablePrimitive>
        </DataTemplate>
        <!--
            纯折线 Polyline（BandPolyline 的无带宽兄弟）：仅骨架沿的 PathData 描边显示。
            不带轮廓/接缝/逐顶点带宽控制，绑 PolylineGeometry（独立于 OutlineGeometry 缓存）。
            与 BandPolyline 共用顶点编辑手柄（拖动改 PathData），BandWidth/VertexBandWidths 不显示/不可调。
            不绑 Width/Height，让 Path 自然撑出骨架长度。
        -->
        <DataTemplate x:Key="L1PolylineNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive Opacity="{Binding Opacity}">
                <Grid>
                    <!--
                        纯骨架 stroke-only Path：PolylineGeometry 由 PathData 解析得到（开放 LineTo，无填充、无闭合）。
                        StrokeThickness 与形状类（Rect/Ellipse/Circle 等）统一为 0.8，
                        让 Polyline 与其他图元放在一起描边宽度一致；选中态仅改颜色，不加粗（Polyline 永远不带带宽）。
                    -->
                    <Path
                        Data="{Binding PolylineGeometry}"
                        Stretch="None"
                        Stroke="{Binding StrokeBrush}"
                        StrokeDashArray="{Binding StrokeDashArray}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="{Binding StrokeWidth}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Opacity" Value="1.0" />
                                <Style.Triggers>
                                    <!--  闭合形态下隐藏开放骨架（OutlineGeometry 已含闭合轮廓）  -->
                                    <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <!--
                        闭合形态：骨架点直连单环，形成可填充的闭合多边形（复用 BandPolyline 的 OutlineGeometry 管道，
                        仅轮廓点生成方式不同——Polyline 无带宽偏移）。
                        绑 FillBrush / StrokeBrush：与 BandPolyline 同一管道，属性面板调填充色/描边色都能实时反映。
                    -->
                    <Path Data="{Binding OutlineGeometry}" Stretch="None">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Stroke" Value="{Binding StrokeBrush}" />
                                <Setter Property="StrokeThickness" Value="{Binding StrokeWidth}" />
                                <Setter Property="StrokeDashArray" Value="{Binding StrokeDashArray}" />
                                <Setter Property="StrokeLineJoin" Value="Miter" />
                                <Setter Property="Fill" Value="{Binding FillBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </views:DraggablePrimitive>
        </DataTemplate>
        <!--  圆角矩形（预设 CornerRadius=4）：与直角矩形共用同一套可编辑逻辑  -->
        <DataTemplate x:Key="L1RoundedNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive
                Width="{Binding Width}"
                Height="{Binding Height}"
                Opacity="{Binding Opacity}">
                <!--  圆角矩形：同样去掉 Fill，纯描边与直线一致。  -->
                <Rectangle
                    Width="{Binding Width}"
                    Height="{Binding Height}"
                    Fill="{StaticResource Brush.Bg.Transparent}"
                    RadiusX="{Binding CornerRadius}"
                    RadiusY="{Binding CornerRadius}"
                    Style="{StaticResource CadShapeSelected}" />
            </views:DraggablePrimitive>
        </DataTemplate>
        <DataTemplate x:Key="L1TriangleNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive
                Width="{Binding Width}"
                Height="{Binding Height}"
                Opacity="{Binding Opacity}">
                <!--  三角形：去掉 Fill，纯描边。  -->
                <Polygon
                    Width="{Binding Width}"
                    Height="{Binding Height}"
                    Fill="{StaticResource Brush.Bg.Transparent}"
                    Points="0.5,0 1,1 0,1"
                    Stretch="Fill"
                    Style="{StaticResource CadShapeSelected}" />
            </views:DraggablePrimitive>
        </DataTemplate>
        <DataTemplate x:Key="L1RingNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive
                Width="{Binding Width}"
                Height="{Binding Height}"
                Opacity="{Binding Opacity}">
                <Grid Width="{Binding Width}" Height="{Binding Height}">
                    <!--
                        圆环：单 Path，Data = RingGeometry（外顺内逆 NonZero → 内圆天然空洞）。
                        Stretch=None：几何即局部坐标（圆心 = 元素中心），Canvas 定位由 ItemContainerStyle 负责。
                    -->
                    <Path
                        Width="{Binding Width}"
                        Height="{Binding Height}"
                        Data="{Binding RingGeometry}"
                        Stretch="None"
                        StrokeLineJoin="Miter"
                        Style="{StaticResource CadShapeSelected}" />
                    <!--
                        圆心标记（编辑辅助，不导出）：十字提示圆心位置，供重合约束"点选圆心"。
                        Data 以布局框中心 (2,2) 为十字中心 + Width/Height=4 + Center 对齐父 Grid
                        → 几何中心 = 布局框中心 = 圆心，严格重合无偏移。
                        （注意：Path 几何原点 (0,0) 在布局框左上角，不能以 (0,0) 为十字中心，否则整体偏左上。）
                    -->
                    <Path
                        Width="4"
                        Height="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 0,2 L 4,2 M 2,0 L 2,4"
                        IsHitTestVisible="False"
                        Opacity="0.65"
                        Stroke="{StaticResource Brush.Brand.StrokeDim}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="0.4" />
                </Grid>
            </views:DraggablePrimitive>
        </DataTemplate>
        <!--
            扇形（Pie）：单 Path，Data = PieGeometry（M 弧起点 A 弧终点 L 圆心 Z 闭合扇面）。
            Stretch=None：几何即局部坐标（圆心 = 元素中心），Canvas 定位由 ItemContainerStyle 负责。
        -->
        <DataTemplate x:Key="L1PieNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive
                Width="{Binding Width}"
                Height="{Binding Height}"
                Opacity="{Binding Opacity}">
                <Grid Width="{Binding Width}" Height="{Binding Height}">
                    <Path
                        Width="{Binding Width}"
                        Height="{Binding Height}"
                        Data="{Binding PieGeometry}"
                        Fill="{Binding FillBrush}"
                        Stretch="None"
                        Stroke="{Binding StrokeBrush}"
                        StrokeDashArray="{Binding StrokeDashArray}"
                        StrokeLineJoin="Miter"
                        StrokeThickness="{Binding StrokeWidth}" />
                </Grid>
            </views:DraggablePrimitive>
        </DataTemplate>
        <!--
            布尔运算结果：多环骨架快照（合并/剪除/相交产物）。
            Path.Data=OutlineGeometry（多环骨架 + 逐顶点圆角重建；F0 填充规则 + 每环一 figure），
            骨架点/轮廓圆角编辑与闭合 Polyline 同一管道（顶点手柄 + 轮廓手柄共用）。
        -->
        <DataTemplate x:Key="L1BooleanPathNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive
                Width="{Binding Width}"
                Height="{Binding Height}"
                Opacity="{Binding Opacity}">
                <Path
                    Width="{Binding Width}"
                    Height="{Binding Height}"
                    Data="{Binding OutlineGeometry}"
                    Fill="{Binding FillBrush}"
                    Stretch="None"
                    Stroke="{Binding StrokeBrush}"
                    StrokeDashArray="{Binding StrokeDashArray}"
                    StrokeLineJoin="Miter"
                    StrokeThickness="{Binding StrokeWidth}" />
            </views:DraggablePrimitive>
        </DataTemplate>
        <!--  兜底模板：未知 TypeKey 图元（历史/第三方新增类型）显示占位框 + 类型名，避免静默不可见。  -->
        <DataTemplate x:Key="L1DefaultNode" DataType="{x:Type models:PrimitiveItem}">
            <views:DraggablePrimitive
                Width="{Binding Width}"
                Height="{Binding Height}"
                Opacity="{Binding Opacity}">
                <Grid Width="{Binding Width}" Height="{Binding Height}">
                    <Rectangle
                        Width="{Binding Width}"
                        Height="{Binding Height}"
                        Stroke="{StaticResource Brush.Border.Subtle}"
                        StrokeDashArray="4 3"
                        Fill="{StaticResource Brush.Bg.Deep}" />
                    <TextBlock
                        Margin="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Text="{Binding TypeKey}"
                        Foreground="{StaticResource Brush.Text.Secondary}"
                        TextWrapping="Wrap"
                        TextAlignment="Center" />
                </Grid>
            </views:DraggablePrimitive>
        </DataTemplate>
        <!--  DataTemplateSelector：根据 PrimitiveItem 类型选模板（已废弃 L2/FanBlade 分支）  -->
        <views:PrimitiveTemplateSelector
            x:Key="PrimitiveSelector"
            L1BooleanPath="{StaticResource L1BooleanPathNode}"
            L1Ellipse="{StaticResource L1EllipseNode}"
            L1Line="{StaticResource L1LineNode}"
            L1Polyline="{StaticResource L1PolylineNode}"
            L1Rectangle="{StaticResource L1RectangleNode}"
            L1Ring="{StaticResource L1RingNode}"
            L1Pie="{StaticResource L1PieNode}"
            L1RoundedRectangle="{StaticResource L1RoundedNode}"
            L1BandPolyline="{StaticResource L1BandPolylineNode}"
            L1Triangle="{StaticResource L1TriangleNode}"
            L1Default="{StaticResource L1DefaultNode}" />
    </UserControl.Resources>

    <Grid
        Margin="8"
        Focusable="True"
        KeyboardNavigation.TabNavigation="Cycle">
        <Grid.InputBindings>
            <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
            <!--  Enter:完成当前连续绘制(提交为 BandPolyline 图元)  -->
            <KeyBinding Key="Enter" Command="{Binding FinishDrawCommand}" />
            <!--  Backspace:撤销最后一个顶点(画错了用)  -->
            <KeyBinding Key="Backspace" Command="{Binding UndoLastPointCommand}" />
            <!--  Esc:优先放弃当前连续绘制(不提交),否则清空画布  -->
            <KeyBinding Key="Escape" Command="{Binding CancelOrClearCommand}" />
        </Grid.InputBindings>
        <Grid.ColumnDefinitions>
            <!--  列 0：左侧工具栏列。CAD 风格去掉文字标签后，列宽只需容纳小图标 + 少量 padding。  -->
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <!--  列 2：右侧属性/元素面板列（抽屉式：Auto = 展开时由内部内容定宽 240，收起时只剩把手窄条）。  -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  左侧：L1 + L2 工具栏  -->
        <!--
            关键：VerticalAlignment=Top 让 Border 只包到图标内容高度，
            否则 Grid 列0 默认 Stretch 会让 Border 撑到行高（与右侧画布等高），
            导致 Border 内部出现红框那样的大片空白。
        -->
        <Border
            Grid.Column="0"
            Margin="0,0,2,0"
            VerticalAlignment="Top"
            Background="{StaticResource Brush.Bg.Deep}"
            BorderBrush="{StaticResource MetalFrameInner}"
            BorderThickness="1"
            CornerRadius="4">
            <!--
                工具栏：CAD 风格——一组扁平图标列表，无段标题/主标题，按需用细分隔线分组。
                单一 StackPanel(Vertical) 直接容纳所有图标，无 Grid 行定义 → 无"空白行"。
            -->
            <StackPanel Margin="2,6">
                <ItemsControl ItemsSource="{Binding DrawingTools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ToolboxEntry}">
                            <!--
                                所有工具统一走 MouseLeftButtonUp → SelectTool → DrawMode。
                                高亮态：MultiBinding 比较当前 item 的 Key 与 ActiveToolKey，仅命中自身。
                                （不能把 Background/BorderBrush 设为本地值，否则本地值优先级高于 Style 触发器，高亮永不生效。）
                            -->
                            <Border
                                Margin="0,1"
                                BorderThickness="1"
                                CornerRadius="2"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnToolboxItemClick"
                                Tag="{Binding Key}"
                                ToolTip="{Binding Label}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.Bg.Transparent}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Bg.Transparent}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource KeyActive}">
                                                        <Binding Path="Key" />
                                                        <Binding Path="DataContext.ActiveToolKey" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{StaticResource Brush.Bg.Selected}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.State.AccentBorder}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ContentControl
                                    Margin="2,4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Key}" Value="L1_Rectangle">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource L1RectanglePreview}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="L1_Ellipse">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource L1EllipsePreview}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="L1_RoundedRectangle">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource L1RoundedPreview}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="L1_Triangle">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource L1TrianglePreview}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="L1_Ring">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource L1RingPreview}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="L1_Pie">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource L1PiePreview}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="L1_Line">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource L1LinePreview}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="L1_Polyline">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource L1PolylinePreview}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="L1_BandPolyline">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource L1BandPolylinePreview}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  右侧：工具栏 + 画布  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl
                Grid.Row="0"
                Margin="0,0,0,8"
                Style="{StaticResource RibbonTabControl}">

                <!--  ═══ 常用：编辑 / 排列 / 布尔 ═══  -->
                <TabItem Header="常用" Style="{StaticResource RibbonTabItem}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel Margin="2,2,0,4" Orientation="Horizontal">

                            <!--  面板「修改」  -->
                            <Border Style="{StaticResource RibbonPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonPanelCaption}" Text="修改" />
                                    <StackPanel Orientation="Horizontal">
                                        <!--  撤销: Segoe MDL2 Assets E7A7 (Undo)  -->
                    <Border
                        IsEnabled="{Binding CanUndo}"
                        MouseLeftButtonDown="OnUndoClick"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="撤销">
                        <Border.Style>
                            <Style BasedOn="{StaticResource ToolIconButton}" TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE7A7;" />
                    </Border>
                    <!--  重做: Segoe MDL2 Assets E7A6 (Redo)  -->
                    <Border
                        IsEnabled="{Binding CanRedo}"
                        MouseLeftButtonDown="OnRedoClick"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="重做">
                        <Border.Style>
                            <Style BasedOn="{StaticResource ToolIconButton}" TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE7A6;" />
                    </Border>
                    <!--  删除选中: Segoe MDL2 Assets E74D (Delete)  -->
                    <Border
                        MouseLeftButtonDown="OnDeleteSelectedClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="删除选中 (Delete)">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE74D;" />
                    </Border>
                    <!--  全部清空: Segoe MDL2 Assets E75C (Clear)  -->
                    <Border
                        MouseLeftButtonDown="OnClearAllClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="全部清空">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE75C;" />
                    </Border>

                    <!--
                        格式刷：选中图元 → 点击按钮吸取样式（线条/填充），再点其它图元即应用并自动退出。
                        自绘"刷子"图标（旋转 45° 的矩形刷头 + 手柄），比 Segoe MDL2 私有区字符更直观。
                        高亮态：IsFormatPainterActive=true 时边框变蓝、背景变深蓝灰（与左侧工具栏激活态一致）。
                        Ctrl+点击 → 进入连刷模式（应用样式后不退出，便于批量刷同一外观）。
                        IsEnabled 绑 CanPickFormat（未选中图元时禁用，文字框聚焦时也不拦截 Ctrl+C/V）。
                    -->
                    <Border
                        MouseLeftButtonDown="OnFormatPainterClick"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="格式刷 (选中图元后点此按钮吸取样式, 再点其它图元即应用。Ctrl+点击进入连刷模式)">
                        <Border.Style>
                            <Style BasedOn="{StaticResource ToolIconButton}" TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                    <!--  激活态：背景变深蓝灰 + 边框亮蓝（与左侧绘图工具激活态一致）  -->
                                    <DataTrigger Binding="{Binding IsFormatPainterActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.Tool.HoverBlue}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.State.AccentBorder}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Opacity" Value="1.0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!--  格式刷图标（用户自绘）：刷头 + 斜刷柄 + 手柄，Viewbox 等比缩放撑满 16×16。  -->
                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                            <Canvas Width="40.19" Height="67.82">
                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="33.34" Height="9.59" Panel.ZIndex="0" Fill="{StaticResource Brush.Text.Primary}" Stroke="{StaticResource Brush.Brand.StrokeMuted}" StrokeThickness="0.8" />
                                <Path Canvas.Left="17.81" Canvas.Top="4.11" Data="M15.53,0L22.38,0 22.38,10.28 0,18.04 0,31.51" Panel.ZIndex="1" Stroke="{StaticResource Brush.Brand.StrokeMuted}" StrokeThickness="0.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" />
                                <Rectangle Canvas.Left="14.16" Canvas.Top="35.62" Width="7.31" Height="32.2" Panel.ZIndex="2" Fill="{StaticResource Brush.Text.Primary}" Stroke="{StaticResource Brush.Brand.StrokeMuted}" StrokeThickness="0.8" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!--  面板「排列」  -->
                                    <Border Style="{StaticResource RibbonPanel}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RibbonPanelCaption}" Text="排列" />
                                            <StackPanel Orientation="Horizontal">
                                        <!--  水平镜像: 围绕选中集包围盒水平中心左右翻转（↔，Segoe UI Symbol）  -->
                    <Border
                        IsEnabled="{Binding HasMirrorTarget}"
                        MouseLeftButtonDown="OnMirrorHorizontalClick"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="水平镜像">
                        <Border.Style>
                            <Style BasedOn="{StaticResource ToolIconButton}" TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontFamily="Segoe UI Symbol"
                            Style="{StaticResource ToolIconGlyph}"
                            Text="&#x2194;" />
                    </Border>
                    <!--  垂直镜像: 围绕选中集包围盒垂直中心上下翻转（↕，Segoe UI Symbol）  -->
                    <Border
                        IsEnabled="{Binding HasMirrorTarget}"
                        MouseLeftButtonDown="OnMirrorVerticalClick"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="垂直镜像">
                        <Border.Style>
                            <Style BasedOn="{StaticResource ToolIconButton}" TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontFamily="Segoe UI Symbol"
                            Style="{StaticResource ToolIconGlyph}"
                            Text="&#x2195;" />
                    </Border>

                    <!--  置顶：顶部横线 + 下插杆上箭头（提到最顶）。形状取自 XAML 导出样例。  -->
                    <Border
                        MouseLeftButtonDown="OnBringToFrontClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="置顶 (遮挡所有元素)">
                        <Viewbox
                            Width="16"
                            Height="16"
                            Stretch="Uniform">
                            <Canvas Width="34" Height="44">
                                <Path
                                    Canvas.Left="0.79"
                                    Canvas.Top="3"
                                    Data="M0,3L32.42,3 32.42,-3 0,-3z"
                                    Fill="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag, Converter={StaticResource TagBrush}, ConverterParameter=2}" />
                                <Path
                                    Canvas.Left="16.36"
                                    Canvas.Top="5.7"
                                    Data="M-0.5,0L-10.746927374301675,13.02 -3,13.02 -3,37.9 3,37.9 3,13.02 10.746927374301675,13.02 0.5,0z"
                                    Fill="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag, Converter={StaticResource TagBrush}, ConverterParameter=2}" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <!--  上移：下插杆上箭头（与置顶同款箭头，无顶线），尖端朝上  -->
                    <Border
                        MouseLeftButtonDown="OnMoveUpClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="上移一层">
                        <Viewbox
                            Width="16"
                            Height="16"
                            Stretch="Uniform">
                            <Canvas Width="34" Height="44">
                                <Path
                                    Canvas.Left="16.36"
                                    Canvas.Top="3"
                                    Data="M-0.5,0L-10.746927374301675,13.02 -3,13.02 -3,37.9 3,37.9 3,13.02 10.746927374301675,13.02 0.5,0z"
                                    Fill="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag, Converter={StaticResource TagBrush}, ConverterParameter=2}" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <!--  下移：下插杆下箭头（上移箭头上下颠倒），尖端朝下  -->
                    <Border
                        MouseLeftButtonDown="OnMoveDownClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="下移一层">
                        <Viewbox
                            Width="16"
                            Height="16"
                            Stretch="Uniform">
                            <Canvas Width="34" Height="44">
                                <Path
                                    Canvas.Left="16.36"
                                    Canvas.Top="3"
                                    Data="M-0.5,37.9L-10.746927374301675,24.88 -3,24.88 -3,0 3,0 3,24.88 10.746927374301675,24.88 0.5,37.9z"
                                    Fill="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag, Converter={StaticResource TagBrush}, ConverterParameter=2}" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <!--  置底：底线 + 下插杆下箭头（置顶整体上下颠倒），尖端朝下贴底线  -->
                    <Border
                        MouseLeftButtonDown="OnSendToBackClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="置底 (被所有元素遮挡)">
                        <Viewbox
                            Width="16"
                            Height="16"
                            Stretch="Uniform">
                            <Canvas Width="34" Height="44">
                                <Path
                                    Canvas.Left="16.36"
                                    Canvas.Top="5.7"
                                    Data="M-0.5,37.9L-10.746927374301675,24.88 -3,24.88 -3,0 3,0 3,24.88 10.746927374301675,24.88 0.5,37.9z"
                                    Fill="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag, Converter={StaticResource TagBrush}, ConverterParameter=2}" />
                                <Path
                                    Canvas.Left="0.79"
                                    Canvas.Top="41"
                                    Data="M0,3L32.42,3 32.42,-3 0,-3z"
                                    Fill="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag, Converter={StaticResource TagBrush}, ConverterParameter=2}" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!--  面板「布尔」  -->
                                <Border Style="{StaticResource RibbonPanel}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RibbonPanelCaption}" Text="布尔" />
                                        <StackPanel Orientation="Horizontal">

                    <!--
                        ── 布尔运算组（合并/剪除/相交）：Ctrl+点击恰好选中 2 个闭合图元后可用。
                        图标用数学符号 ∪ / − / ∩（Segoe UI Symbol 覆盖 MDL2 字体，语义直观）。
                    -->
                    <!--  合并 ∪: 两个闭合图元并集  -->
                    <Border
                        IsEnabled="{Binding CanBooleanOp}"
                        MouseLeftButtonDown="OnMergeShapesClick"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="合并 (Ctrl+点击选中两个闭合图元后可用, 求并集)">
                        <Border.Style>
                            <Style BasedOn="{StaticResource ToolIconButton}" TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontFamily="Segoe UI Symbol"
                            Style="{StaticResource ToolIconGlyph}"
                            Text="&#x222A;" />
                    </Border>
                    <!--  剪除 −: 先选图元减后选图元 (A ∖ B)  -->
                    <Border
                        IsEnabled="{Binding CanBooleanOp}"
                        MouseLeftButtonDown="OnSubtractShapesClick"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="剪除 (先选的图元 − 后选的图元)">
                        <Border.Style>
                            <Style BasedOn="{StaticResource ToolIconButton}" TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontFamily="Segoe UI Symbol"
                            Style="{StaticResource ToolIconGlyph}"
                            Text="&#x2212;" />
                    </Border>
                    <!--  相交 ∩: 两个闭合图元交集  -->
                    <Border
                        IsEnabled="{Binding CanBooleanOp}"
                        MouseLeftButtonDown="OnIntersectShapesClick"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="相交 (两个闭合图元求交集)">
                        <Border.Style>
                            <Style BasedOn="{StaticResource ToolIconButton}" TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontFamily="Segoe UI Symbol"
                            Style="{StaticResource ToolIconGlyph}"
                            Text="&#x2229;" />
                    </Border>

                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ═══ 参数化：几何约束 / 阵列 ═══  -->
                <TabItem Header="参数化" Style="{StaticResource RibbonTabItem}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel Margin="2,2,0,4" Orientation="Horizontal">

                            <!--  面板「几何约束」  -->
                            <Border Style="{StaticResource RibbonPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonPanelCaption}" Text="几何约束" />
                                    <StackPanel Orientation="Horizontal">

                    <!--
                        相切约束: 选中一条直线 + 一个圆后点击,圆自动移与直线相切(持久约束)。
                        E891 = Link 图标
                    -->
                    <Border
                        IsEnabled="{Binding CanApplyTangent}"
                        MouseLeftButtonDown="OnApplyTangentClick"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="相切约束 (Ctrl+点击选择直线和圆, 绿色点亮可用)">
                        <Border.Style>
                            <Style BasedOn="{StaticResource ToolIconButton}" TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE891;" />
                    </Border>

                    <!--
                        重合约束: 选中一条直线 + 一个圆后点击,智能识别"端点落圆弧"或"圆心落直线"(持久约束)。
                        E173 = BulletList (圆点) 图标
                    -->
                    <Border
                        IsEnabled="{Binding CanApplyCoincident}"
                        MouseLeftButtonDown="OnApplyCoincidentClick"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="重合约束 (Ctrl+点击选择直线和圆, 蓝色点亮可用)">
                        <Border.Style>
                            <Style BasedOn="{StaticResource ToolIconButton}" TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE173;" />
                    </Border>

                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  面板「阵列」  -->
                            <Border Style="{StaticResource RibbonPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonPanelCaption}" Text="阵列" />
                                    <StackPanel Orientation="Horizontal">
                                        <!--
                                        阵列 (CAD Array)：矩形 / 环形 / 路径三种，选中源图形后即预览。
                                        Segoe MDL2 Assets E7B8 (Copy)
                                    -->
                                    <Border
                                        MouseLeftButtonDown="OnPathArrayClick"
                                        Style="{StaticResource ToolIconButton}"
                                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                                        ToolTip="阵列: 选中源图形后即预览 (矩形 / 环形 / 路径)">
                                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE7B8;" />
                                    </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ═══ 插入：工程 / 参考 ═══  -->
                <TabItem Header="插入" Style="{StaticResource RibbonTabItem}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel Margin="2,2,0,4" Orientation="Horizontal">

                            <!--  面板「工程」  -->
                            <Border Style="{StaticResource RibbonPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonPanelCaption}" Text="工程" />
                                    <StackPanel Orientation="Horizontal">

                    <!--  ── 第二组：工程文件（蓝色调） ──  -->
                    <!--  加载: Segoe MDL2 Assets E8E5 (OpenFile)  -->
                    <Border
                        MouseLeftButtonDown="OnLoadProjectClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="加载工程 (.sym.json)">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE8E5;" />
                    </Border>
                    <!--  导入 SVG：支持基本几何 + 折线 + path（曲线自动降采样）。
                          仅导入几何,不导入渐变/滤镜/文字。toolTip="导入 SVG 文件"  -->
                    <Border
                        MouseLeftButtonDown="OnImportSvgClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="导入 SVG (支持 rect/circle/ellipse/line/polyline/polygon/path,曲线自动降采样)">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE8B5;" />
                    </Border>
                    <!--  保存: Segoe MDL2 Assets E74E (Save)  -->
                    <Border
                        MouseLeftButtonDown="OnSaveProjectClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="保存 (有路径直接覆盖,无路径转另存为)">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE74E;" />
                    </Border>
                    <!--  另存为: Segoe MDL2 Assets E792 (SaveLocal)  -->
                    <Border
                        MouseLeftButtonDown="OnSaveAsProjectClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="另存为...">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE792;" />
                    </Border>
                    <!--  导出 XAML: Segoe MDL2 Assets EDE1 (Export)  -->
                    <Border
                        MouseLeftButtonDown="OnExportXamlClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="导出 XAML">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xEDE1;" />
                    </Border>

                                    </StackPanel>
                                </StackPanel>
                            </Border>

                    <!--  面板「参考」  -->
                            <Border Style="{StaticResource RibbonPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonPanelCaption}" Text="参考" />
                                    <StackPanel Orientation="Horizontal">

                    <!--  导入背景: Segoe MDL2 Assets E8B7 (Photo)  -->
                    <Border
                        MouseLeftButtonDown="OnImportBackgroundImageClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="导入背景参考图 (按图描图)">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE8B7;" />
                    </Border>
                    <!--  清除背景: Segoe MDL2 Assets E711 (Cancel)  -->
                    <Border
                        MouseLeftButtonDown="OnClearBackgroundImageClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="清除背景">
                        <TextBlock Text="&#xE711;">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource ToolIconGlyph}" TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <!--  透明度: Segoe MDL2 Assets E7B3 (Opacity)  -->
                    <Border
                        Style="{StaticResource ToolComboButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="背景图透明度">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE7B3;" />
                            <Slider
                                Width="64"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding HasBackgroundImage}"
                                LargeChange="0.1"
                                Maximum="1.0"
                                Minimum="0.05"
                                SmallChange="0.05"
                                Value="{Binding BackgroundOpacity, Mode=TwoWay}" />
                            <TextBlock
                                Width="28"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="9"
                                Foreground="{StaticResource Brush.Text.Tertiary}"
                                Text="{Binding BackgroundOpacity, Mode=OneWay, StringFormat={}{0:P0}}"
                                TextAlignment="Right" />
                        </StackPanel>
                    </Border>
                    <!--  适配模式: Segoe MDL2 Assets E9A6 (FitWidth)  -->
                    <Border
                        Style="{StaticResource ToolComboButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="背景图适配: CanvasSize (撑满画布) / ImageSize (1:1 原尺寸)">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE9A6;" />
                            <ComboBox
                                MinWidth="86"
                                Margin="4,0,0,0"
                                Padding="4,1"
                                VerticalAlignment="Center"
                                Background="{StaticResource Brush.Bg.Input}"
                                BorderBrush="{StaticResource Brush.Tool.BorderAmber}"
                                FontSize="11"
                                Foreground="{StaticResource Brush.Tool.Icon}"
                                IsEnabled="{Binding HasBackgroundImage}"
                                SelectedItem="{Binding BackgroundFitMode, Mode=TwoWay}">
                                <sys:String>CanvasSize</sys:String>
                                <sys:String>ImageSize</sys:String>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ═══ 视图：缩放 ═══  -->
                <TabItem Header="视图" Style="{StaticResource RibbonTabItem}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel Margin="2,2,0,4" Orientation="Horizontal">

                            <!--  面板「缩放」  -->
                            <Border Style="{StaticResource RibbonPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonPanelCaption}" Text="缩放" />
                                    <StackPanel Orientation="Horizontal">

                    <!--  缩小: Segoe MDL2 Assets E738 (ZoomOut)  -->
                    <Border
                        MouseLeftButtonDown="OnZoomOutClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="缩小 (Ctrl+滚轮)">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE738;" />
                    </Border>
                    <!--  缩放比例显示（点击重置为 100%）  -->
                    <Border
                        MouseLeftButtonDown="OnZoomResetClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="重置缩放为 100%">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="{Binding ZoomLevel, Mode=OneWay, StringFormat={}{0:P0}}" />
                    </Border>
                    <!--  放大: Segoe MDL2 Assets E710 (ZoomIn)  -->
                    <Border
                        MouseLeftButtonDown="OnZoomInClick"
                        Style="{StaticResource ToolIconButton}"
                        Tag="Brush.Bg.Darker,Brush.Tool.BorderNeutral,Brush.Tool.Icon"
                        ToolTip="放大 (Ctrl+滚轮)">
                        <TextBlock Style="{StaticResource ToolIconGlyph}" Text="&#xE710;" />
                    </Border>

                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border
                Grid.Row="1"
                Background="{StaticResource Brush.Bg.CanvasChrome}"
                BorderBrush="{StaticResource MetalFrameInner}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="4">
                <Grid>
                    <controls:ZoomPanViewport
                        x:Name="ZoomPan"
                        ContentHeight="{Binding CanvasHeight}"
                        ContentWidth="{Binding CanvasWidth}"
                        PanX="{Binding PanX, Mode=TwoWay}"
                        PanY="{Binding PanY, Mode=TwoWay}"
                        ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}">
                        <Grid
                            x:Name="CanvasHost"
                            Width="{Binding CanvasWidth}"
                            Height="{Binding CanvasHeight}"
                            Background="{Binding CanvasBackgroundBrush}"
                            IsHitTestVisible="True"
                            MouseLeftButtonDown="OnCanvasDrawMouseDown"
                            MouseLeftButtonUp="OnCanvasDrawMouseUp"
                            MouseMove="OnCanvasDrawMouseMove"
                            MouseRightButtonDown="OnCanvasMarqueeDown"
                            MouseRightButtonUp="OnCanvasMarqueeUp">
                            <Grid.Style>
                                <!--
                                    画线模式（IsDrawModeActive）时画布光标切换为十字准星，提示"点击起笔 / 逐点连线"。
                                    退出绘制模式自动恢复箭头（默认）。
                                -->
                                <Style TargetType="Grid">
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDrawModeActive}" Value="True">
                                            <Setter Property="Cursor" Value="Cross" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Image
                                IsHitTestVisible="False"
                                Opacity="{Binding BackgroundOpacity}"
                                SnapsToDevicePixels="True"
                                Source="{Binding BackgroundImageSource}"
                                Stretch="Uniform"
                                Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVis}}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <!--  默认：CanvasSize 模式 → 撑满画布（Width/Height 跟随 CanvasWidth/Height）  -->
                                        <Setter Property="Width" Value="{Binding CanvasWidth}" />
                                        <Setter Property="Height" Value="{Binding CanvasHeight}" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BackgroundFitMode}" Value="ImageSize">
                                                <!--  图片原始尺寸 1:1 显示（不放大，仅原尺寸）  -->
                                                <Setter Property="Width" Value="NaN" />
                                                <Setter Property="Height" Value="NaN" />
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="VerticalAlignment" Value="Top" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <Path
                                Data="{Binding DraftPathData}"
                                Fill="{StaticResource Brush.Bg.Transparent}"
                                IsHitTestVisible="False"
                                Stretch="None"
                                Visibility="{Binding IsDrawing, Converter={StaticResource BoolToVis}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{StaticResource Brush.State.Accent}" />
                                        <Setter Property="StrokeThickness" Value="{Binding StrokeWidthS}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPathSnappingActive}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource Brush.State.Success}" />
                                                <Setter Property="StrokeThickness" Value="{Binding StrokeWidthM}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!--
                                对象追踪贯穿提示线（CAD Object Snap Tracking 风格）：
                                当鼠标与已画点 P_i 的 X 同坐标 → 画一条从画布顶到底的竖向虚线（橙色）；
                                当鼠标与 P_i 的 Y 同坐标 → 画一条从画布左到右的横向虚线（橙色）。
                                画布尺寸通过绑定 CanvasWidth/CanvasHeight 动态撑满，
                                仅在 IsObjectSnapTrackingX/Y=true 时显示（不吸附时自动隐藏）。
                                与橡皮线 IsPathSnappingActive（绿色/轴对齐）互不冲突——可同时激活。
                            -->
                            <Line
                                IsHitTestVisible="False"
                                Stretch="None"
                                Stroke="{StaticResource Brush.State.Warn}"
                                StrokeDashArray="{Binding DashXs}"
                                StrokeThickness="{Binding StrokeWidthXs}"
                                X1="{Binding ObjectSnapTrackingX}"
                                X2="{Binding ObjectSnapTrackingX}"
                                Y1="0"
                                Y2="{Binding CanvasHeight}"
                                Visibility="{Binding IsObjectSnapTrackingX, Converter={StaticResource BoolToVis}}" />
                            <Line
                                IsHitTestVisible="False"
                                Stretch="None"
                                Stroke="{StaticResource Brush.State.Warn}"
                                StrokeDashArray="{Binding DashXs}"
                                StrokeThickness="{Binding StrokeWidthXs}"
                                X1="0"
                                X2="{Binding CanvasWidth}"
                                Y1="{Binding ObjectSnapTrackingY}"
                                Y2="{Binding ObjectSnapTrackingY}"
                                Visibility="{Binding IsObjectSnapTrackingY, Converter={StaticResource BoolToVis}}" />

                            <!--
                                形状工具的实时轮廓预览（Rectangle/RoundedRectangle/Ellipse/Ring/Triangle）。
                                阶段 3：从"中心点 → 当前鼠标"动态生成 PathGeometry，
                                蓝绿色描边 + 半透明填充，让用户在第 2 次点击前就能预判最终形状。
                                注：WPF Path 的 FillRule 属性不在 presentation 命名空间，需通过 PathGeometry.FillRule 设置；
                                为了统一处理（Rectangle/Ellipse/Ring/Triangle 都用字符串 Data），
                                这里退化为 Nonzero 填充规则——Ring 预览显示为实心椭圆（半透明蓝），
                                真实镂空由图元模板渲染，预览仅用于"大小+位置"对位。
                            -->
                            <Path
                                Data="{Binding DraftShapeData}"
                                Fill="{StaticResource Brush.State.AccentFill}"
                                IsHitTestVisible="False"
                                Stretch="None"
                                Stroke="{StaticResource Brush.State.AccentBorder}"
                                StrokeThickness="{Binding StrokeWidthM}"
                                Visibility="{Binding IsShapePreviewVisible, Converter={StaticResource BoolToVis}}" />

                            <!--
                                扇形中轴吸附提示线（CAD 轴对齐风格，绿色虚线）：
                                绘制扇形第二点（定朝向）时，中轴命中特殊角（45°/30°倍数）即吸附；
                                此时从圆心沿吸附后的对称中轴方向延伸一根虚线，提示"中轴已锁定在特殊角"，
                                与画直线时的绿色轴对齐提示线一致。
                            -->
                            <Line
                                IsHitTestVisible="False"
                                Stretch="None"
                                Stroke="{StaticResource Brush.State.Success}"
                                StrokeDashArray="{Binding DashS}"
                                StrokeEndLineCap="Round"
                                StrokeThickness="{Binding StrokeWidthM}"
                                X1="{Binding PieAxisGuideX1}"
                                Y1="{Binding PieAxisGuideY1}"
                                X2="{Binding PieAxisGuideX2}"
                                Y2="{Binding PieAxisGuideY2}"
                                Visibility="{Binding PieAxisGuideEnabled, Converter={StaticResource BoolToVis}}" />

                            <!--
                                扇形朝向实时角度读数（CAD 极轴角度标注）：
                                绘制扇形第二点（定朝向）时在鼻尖附近显示当前朝向角；吸附到特殊角时显示整度数（如 45°）。
                                必须放 Canvas 内，Canvas.Left/Top 才能定位（宿主是 Grid，Grid 忽略该附加属性才会不显示/停角落）。
                                反向缩放保持屏幕字号恒定；半透明深色底 + 白字，便于画布叠加可读。
                            -->
                            <Canvas
                                Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}"
                                IsHitTestVisible="False">
                                <Border
                                    Padding="4,1.5"
                                    Background="{StaticResource Brush.Overlay.Dim}"
                                    CornerRadius="2"
                                    Panel.ZIndex="9997"
                                    Canvas.Left="{Binding PieAngleTextX}"
                                    Canvas.Top="{Binding PieAngleTextY}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Visibility="{Binding PieAngleTextVisible, Converter={StaticResource BoolToVis}}">
                                    <Border.RenderTransform>
                                        <ScaleTransform
                                            ScaleX="{Binding InverseScale}"
                                            ScaleY="{Binding InverseScale}" />
                                    </Border.RenderTransform>
                                    <TextBlock
                                        FontSize="9"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding PieAngleText}" />
                                </Border>
                            </Canvas>

                            <!--
                                草稿已确认顶点的视觉标记（小方块）。
                                样式与选中后的顶点手柄（VertexHandles）统一：2×2 淡蓝方块 + 白描边，
                                让水平/垂直同一直线上连点时也能一眼数清已连了几个点。
                            -->
                            <ItemsControl
                                IsHitTestVisible="False"
                                ItemsSource="{Binding DraftPoints}"
                                Visibility="{Binding IsDrawing, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <!--  Canvas.Left/Top 绑顶点坐标；Margin=-1.5 使方块中心对齐顶点  -->
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Width" Value="3" />
                                        <Setter Property="Height" Value="3" />
                                        <Setter Property="Margin" Value="-1.5,-1.5,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  草稿端点标记：与顶点手柄同款 3×3 蓝色小方块（不响应鼠标，仅视觉提示）。
                                            反向缩放：方块随画布放大而不变大，任何比例下屏幕尺寸恒为 3px，中心仍贴顶点。  -->
                                        <Rectangle
                                            Width="3"
                                            Height="3"
                                            Fill="{StaticResource Brush.State.Accent}"
                                            RenderOptions.EdgeMode="Aliased"
                                            SnapsToDevicePixels="True"
                                            RenderTransformOrigin="0.5,0.5"
                                            Stroke="{StaticResource Brush.Brand.Stroke}"
                                            StrokeThickness="0.1">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform
                                                    ScaleX="{Binding InverseScale}"
                                                    ScaleY="{Binding InverseScale}" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                起点吸附高亮：绘制 Polyline 时，鼠标移动到首顶点附近（DraftSnapToStart=true），
                                起点套上绿色圆环 + 实心绿点覆盖原蓝色起点方块（Brush.State.Success token），
                                提示"点击此处即可闭环"。位置跟随 DraftPoints[0]；不响应鼠标。
                            -->
                            <Ellipse
                                Canvas.Left="{Binding DraftPoints[0].X}"
                                Canvas.Top="{Binding DraftPoints[0].Y}"
                                Width="8"
                                Height="8"
                                Margin="-4,-4,0,0"
                                Fill="{StaticResource Brush.State.SuccessLight}"
                                IsHitTestVisible="False"
                                Stroke="{StaticResource Brush.State.Success}"
                                StrokeThickness="1.2"
                                Visibility="{Binding DraftSnapToStart, Converter={StaticResource BoolToVis}}" />
                            <Rectangle
                                Canvas.Left="{Binding DraftPoints[0].X}"
                                Canvas.Top="{Binding DraftPoints[0].Y}"
                                Width="2"
                                Height="2"
                                Margin="-1,-1,0,0"
                                Fill="{StaticResource Brush.State.Success}"
                                IsHitTestVisible="False"
                                RenderOptions.EdgeMode="Aliased"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding DraftSnapToStart, Converter={StaticResource BoolToVis}}" />

                            <ItemsControl
                                ItemTemplateSelector="{StaticResource PrimitiveSelector}"
                                ItemsSource="{Binding Primitives}"
                                PreviewMouseLeftButtonDown="OnCanvasMouseDown">
                                <ItemsControl.Style>
                                    <!--  画线模式时禁用整个 ItemsControl 的 HitTest，让 CanvasHost 直接接收鼠标。  -->
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDrawModeActive}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Width" Value="{Binding Width}" />
                                        <Setter Property="Height" Value="{Binding Height}" />
                                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                        <!--
                                            元素页"隐藏"开关：Collapsed 后渲染 + 命中测试全禁用（不可见也不可点），
                                            但 Canvas 显式定位不受影响，恢复可见后原位还原。
                                        -->
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                                        <Style.Triggers>
                                            <!--
                                                BandPolyline：扩充需超出原始 Path 包围盒，
                                                不限制 Width/Height，让 Path 自然撑出带宽轮廓
                                            -->
                                            <DataTrigger Binding="{Binding TypeKey}" Value="BandPolyline">
                                                <Setter Property="Width" Value="NaN" />
                                                <Setter Property="Height" Value="NaN" />
                                            </DataTrigger>
                                            <!--  Polyline（无带宽兄弟）：同上，让 Path 自然撑出骨架长度  -->
                                            <DataTrigger Binding="{Binding TypeKey}" Value="Polyline">
                                                <Setter Property="Width" Value="NaN" />
                                                <Setter Property="Height" Value="NaN" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <!--
                                多选子对象拾取标记：高亮被识别的圆心(橙)/端点(绿)。
                                圆心/端点被命中才出标记；圆弧/线段不被命中不显示 →
                                让用户直观区分"选中了圆心还是圆弧""选中了端点还是线段"。
                            -->
                            <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding MultiPickMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Width" Value="3" />
                                        <Setter Property="Height" Value="3" />
                                        <Setter Property="Margin" Value="-1.5,-1.5,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  圆心=橙、端点=绿（画布逻辑坐标经 RenderTransform 放大后视觉合理）  -->
                                        <Ellipse
                                            Width="3"
                                            Height="3"
                                            Fill="{Binding IsCircleCenter, Converter={StaticResource PickCenterBrush}}"
                                            RenderOptions.EdgeMode="Aliased"
                                            SnapsToDevicePixels="True"
                                            Stroke="{StaticResource Brush.Brand.Stroke}"
                                            StrokeThickness="0.3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                沿路径阵列副本（ArrayInstance 展开后的渲染层影子）。
                                与 Primitives 共用 PrimitiveSelector（克隆的 PrimitiveItem 渲染逻辑一致），
                                可接收鼠标事件：点击任一副本 → 选中整个阵列（DraggablePrimitive 按 ArrayOwner
                                路由到 SelectArray）；拖动任一副本 → 整体平移阵列（MoveArrayElement）。
                                ZIndex 起始值 = Primitives.Count + ArrayInstance 偏移（见 RebuildArrayRenderItems）。
                            -->
                            <ItemsControl
                                IsHitTestVisible="True"
                                ItemTemplateSelector="{StaticResource PrimitiveSelector}"
                                ItemsSource="{Binding ArrayRenderItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Width" Value="{Binding Width}" />
                                        <Setter Property="Height" Value="{Binding Height}" />
                                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                        <!--
                                            副本绕自身中心旋转（环形阵列切向对齐 / 路径阵列沿切线站立）：
                                            BuildArrayClones 已把旋转后的锚点位移折算进 X/Y，这里只需绕内容中心转。
                                        -->
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="{Binding Rotation}" />
                                            </Setter.Value>
                                        </Setter>
                                        <!--
                                            阵列副本统一不可见状态：默认可见（与 Primitives 同步 IsVisible 概念暂未实现，
                                            第一阶段仅作占位渲染，POC 完成后补"阵列整组隐藏"等特性）
                                        -->
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <!--  BandPolyline 克隆：扩充需超出 Path 包围盒，不限制 Width/Height  -->
                                            <DataTrigger Binding="{Binding TypeKey}" Value="BandPolyline">
                                                <Setter Property="Width" Value="NaN" />
                                                <Setter Property="Height" Value="NaN" />
                                            </DataTrigger>
                                            <!--  Polyline 克隆：同上  -->
                                            <DataTrigger Binding="{Binding TypeKey}" Value="Polyline">
                                                <Setter Property="Width" Value="NaN" />
                                                <Setter Property="Height" Value="NaN" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <!--
                                环形阵列参考圆环（预览/选中编辑时显示副本分布圆周，直观；确认后随预览层隐藏）。
                                虚线淡蓝描边与画线橡皮线风格一致；IsHitTestVisible=False 不挡鼠标。
                            -->
                            <Canvas IsHitTestVisible="False" Visibility="{Binding IsPathArrayPreviewOpen, Converter={StaticResource BoolToVis}}">
                                <Path
                                    Data="{Binding PolarGuideData}"
                                    Stretch="None"
                                    Stroke="{StaticResource Brush.State.Accent}"
                                    StrokeDashArray="4 2"
                                    StrokeThickness="1"
                                    Visibility="{Binding HasPolarGuide, Converter={StaticResource BoolToVis}}" />
                            </Canvas>

                            <!--
                                阵列预览层（AutoCAD 式"选中即预览"）：创建前的半透明副本，
                                由 StartArrayPreview 生成、类型/参数改动实时重建；确认后清除。
                                与正式副本同一套模板（PrimitiveSelector），IsHitTestVisible=False 不可交互。
                            -->
                            <ItemsControl
                                IsHitTestVisible="False"
                                ItemTemplateSelector="{StaticResource PrimitiveSelector}"
                                ItemsSource="{Binding PathArrayPreviewItems}"
                                Opacity="0.45"
                                Visibility="{Binding IsPathArrayPreviewOpen, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Width" Value="{Binding Width}" />
                                        <Setter Property="Height" Value="{Binding Height}" />
                                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                        <!--  预览副本同样应用旋转（所见即所得：预览时就能看到切向对齐效果）  -->
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="{Binding Rotation}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TypeKey}" Value="BandPolyline">
                                                <Setter Property="Width" Value="NaN" />
                                                <Setter Property="Height" Value="NaN" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TypeKey}" Value="Polyline">
                                                <Setter Property="Width" Value="NaN" />
                                                <Setter Property="Height" Value="NaN" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <!--
                                顶点编辑手柄：仅在骨架模式下显示（轮廓模式下隐藏，避免和接缝手柄混淆）。
                                手柄用 Canvas 定位，跟随顶点画布坐标。鼠标按下→拖拽→同步回 PathData。
                            -->
                            <ItemsControl
                                IsHitTestVisible="True"
                                ItemsSource="{Binding VertexHandles}"
                                PreviewMouseLeftButtonDown="OnVertexMouseDown"
                                PreviewMouseLeftButtonUp="OnVertexMouseUp"
                                PreviewMouseMove="OnVertexMouseMove"
                                Visibility="{Binding IsOutlineEditMode, Converter={StaticResource InverseBoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <!--  Canvas.Left/Top 绑 VertexHandle.X/Y；Margin=-1.5 使手柄中心对齐顶点  -->
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="9999" />
                                        <Setter Property="Width" Value="3" />
                                        <Setter Property="Height" Value="3" />
                                        <Setter Property="Margin" Value="-1.5,-1.5,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  顶点手柄：3×3 蓝色方块。
                                            反向缩放：任何缩放比例下屏幕尺寸恒为 3px，中心仍贴顶点。  -->
                                        <Rectangle
                                            Width="3"
                                            Height="3"
                                            Cursor="SizeAll"
                                            Fill="{StaticResource Brush.State.Accent}"
                                            Stroke="{StaticResource Brush.Brand.Stroke}"
                                            StrokeThickness="0.1"
                                            RenderTransformOrigin="0.5,0.5"
                                            Tag="{Binding Index}"
                                            ToolTip="拖拽以编辑顶点">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform
                                                    ScaleX="{Binding InverseScale}"
                                                    ScaleY="{Binding InverseScale}" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                段拖拽手柄：每段一个，定位在中点。仅骨架模式下显示（带宽/轮廓模式下隐藏）。
                                拖拽以线段为整体平移（保持段长度不变），轴对齐时水平段只允许上下移动、竖直段只允许左右移动。
                            -->
                            <ItemsControl
                                IsHitTestVisible="True"
                                ItemsSource="{Binding SegmentHandles}"
                                PreviewMouseLeftButtonDown="OnSegmentMouseDown"
                                PreviewMouseLeftButtonUp="OnSegmentMouseUp"
                                PreviewMouseMove="OnSegmentMouseMove"
                                Visibility="{Binding IsSkeletonEditMode, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="9998" />
                                        <Setter Property="Width" Value="3.5" />
                                        <Setter Property="Height" Value="3.5" />
                                        <Setter Property="Margin" Value="-1.75,-1.75,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  段手柄：3.5×3.5 橙色方块（与顶点蓝色方块区分）。反向缩放：屏幕尺寸恒定。  -->
                                        <Rectangle
                                            Width="3.5"
                                            Height="3.5"
                                            Cursor="SizeAll"
                                            Fill="{StaticResource Brush.State.Warn}"
                                            Stroke="{StaticResource Brush.Brand.Stroke}"
                                            StrokeThickness="0.1"
                                            RenderTransformOrigin="0.5,0.5"
                                            ToolTip="拖拽以平移整段线段（保持长度）">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform
                                                    ScaleX="{Binding InverseScale}"
                                                    ScaleY="{Binding InverseScale}" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                带宽线端点手柄：仅带宽模式下显示。每段 4 个（L/R × Start/End）。
                                阶段 3 实现：仅显示，无拖拽。后续阶段可加拖拽/调整带宽。
                                形状：左 L 蓝点，右 R 橙点；点击 → 高亮属性面板对应骨点的 Slider。
                            -->
                            <ItemsControl
                                IsHitTestVisible="True"
                                ItemsSource="{Binding BandWidthHandles}"
                                PreviewMouseLeftButtonDown="OnBandWidthHandleMouseDown"
                                Visibility="{Binding IsBandWidthEditMode, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="9998" />
                                        <Setter Property="Width" Value="3" />
                                        <Setter Property="Height" Value="2" />
                                        <Setter Property="Margin" Value="-1.5,-1,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            带宽线端点手柄：三角形。入端 End（Incoming）尖朝上；出端 Start（Outgoing）尖朝下。
                                            左 L 蓝 #81D4FA，右 R 橙 #FF8A65。
                                        -->
                                        <Path
                                            Width="3"
                                            Height="2"
                                            Stretch="Fill"
                                            Stroke="{StaticResource Brush.Brand.Stroke}"
                                            RenderTransformOrigin="0.5,0.5"
                                            StrokeThickness="0.1">
                                            <Path.RenderTransform>
                                                <ScaleTransform
                                                    ScaleX="{Binding InverseScale}"
                                                    ScaleY="{Binding InverseScale}" />
                                            </Path.RenderTransform>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Port.Input}" />
                                                    <!--  默认 = End（入端）：尖朝上  -->
                                                    <Setter Property="Data" Value="M0,4 L6,4 L3,0 Z" />
                                                    <Style.Triggers>
                                                        <!--  Start（出端）：尖朝下  -->
                                                        <DataTrigger Binding="{Binding Endpoint}" Value="Start">
                                                            <Setter Property="Data" Value="M0,0 L6,0 L3,4 Z" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Side}" Value="R">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.State.WarnBorder}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                圆环拖拽手柄：仅选中 L1 Ring 时显示（中心 1 + 外圆 4 + 内圆 4 = 9 个）。
                                Center 中心点：拖动整体平移；Outer 外圆点：拖动改外径（圆心不动）；
                                Inner 内圆点：拖动改内径。
                            -->
                            <ItemsControl
                                IsHitTestVisible="True"
                                ItemsSource="{Binding RingHandles}"
                                PreviewMouseLeftButtonDown="OnRingHandleMouseDown"
                                PreviewMouseLeftButtonUp="OnRingHandleMouseUp"
                                PreviewMouseMove="OnRingHandleMouseMove"
                                Visibility="{Binding SelectedItemIsRing, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="9996" />
                                        <Setter Property="Width" Value="3.5" />
                                        <Setter Property="Height" Value="3.5" />
                                        <Setter Property="Margin" Value="-1.75,-1.75,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  中心手柄：白色小圆；外圆手柄：蓝色方块；内圆手柄：黄色方块。反向缩放：屏幕尺寸恒定。  -->
                                        <Rectangle
                                            Width="3.5"
                                            Height="3.5"
                                            Cursor="SizeAll"
                                            RenderTransformOrigin="0.5,0.5"
                                            Stroke="{StaticResource Brush.Brand.Stroke}"
                                            StrokeThickness="0.1">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform
                                                    ScaleX="{Binding InverseScale}"
                                                    ScaleY="{Binding InverseScale}" />
                                            </Rectangle.RenderTransform>
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Port.Input2}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewmodels:RingHandleKind.Center}">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Brand.Stroke}" />
                                                            <Setter Property="RadiusX" Value="1.75" />
                                                            <Setter Property="RadiusY" Value="1.75" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewmodels:RingHandleKind.Inner}">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Port.Mid}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                扇形拖拽手柄：仅选中 L1 Pie 时显示（中心 1 + 半径 1 + 起始角 1 + 终止角 1 = 4 个）。
                                Center 中心点：拖动整体平移；Radius 半径点：拖动改半径（圆心不动）；
                                Start 起始角点：沿圆周拖动转起始半径；End 终止角点：沿圆周拖动改扫掠角。
                            -->
                            <ItemsControl
                                IsHitTestVisible="True"
                                ItemsSource="{Binding PieHandles}"
                                PreviewMouseLeftButtonDown="OnPieHandleMouseDown"
                                PreviewMouseLeftButtonUp="OnPieHandleMouseUp"
                                PreviewMouseMove="OnPieHandleMouseMove"
                                Visibility="{Binding SelectedItemIsPie, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="9996" />
                                        <Setter Property="Width" Value="3.5" />
                                        <Setter Property="Height" Value="3.5" />
                                        <Setter Property="Margin" Value="-1.75,-1.75,0,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  中心手柄：白色圆点；半径手柄：蓝色方块；起始角：黄色方块；终止角：橙色圆点。反向缩放：屏幕尺寸恒定。  -->
                                        <Rectangle
                                            Cursor="SizeAll"
                                            RenderTransformOrigin="0.5,0.5"
                                            Stroke="{StaticResource Brush.Brand.Stroke}"
                                            StrokeThickness="0.1">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform
                                                    ScaleX="{Binding InverseScale}"
                                                    ScaleY="{Binding InverseScale}" />
                                            </Rectangle.RenderTransform>
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Port.Input2}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewmodels:PieHandleKind.Center}">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Brand.Stroke}" />
                                                            <Setter Property="RadiusX" Value="1.75" />
                                                            <Setter Property="RadiusY" Value="1.75" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewmodels:PieHandleKind.Start}">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Port.Mid}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewmodels:PieHandleKind.End}">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Port.OutputDeep}" />
                                                            <Setter Property="RadiusX" Value="1.75" />
                                                            <Setter Property="RadiusY" Value="1.75" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                轮廓接缝手柄：仅轮廓模式下显示（骨架/带宽模式下隐藏，避免和顶点手柄混淆）。
                                每个手柄定位在接缝的外尖点（miter 顶点），点击选中该接缝 → 属性面板显示其样式编辑。
                            -->
                            <ItemsControl
                                IsHitTestVisible="True"
                                ItemsSource="{Binding OutlineCornerHandles}"
                                PreviewMouseLeftButtonDown="OnOutlineCornerMouseDown"
                                Visibility="{Binding IsOutlineEditMode, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="9997" />
                                        <Setter Property="Width" Value="3" />
                                        <Setter Property="Height" Value="3" />
                                        <Setter Property="Margin" Value="-1.5,-1.5,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Width" Value="4" />
                                                <Setter Property="Height" Value="4" />
                                                <Setter Property="Margin" Value="-2,-2,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            接缝手柄：两类轮廓点视觉区分
                                            - 转角点（Corner）：4×4 蓝色圆点（骨线转折产生，走 join 系统）
                                            - 普通轮廓点（Normal）：2×2 黄色方块（端点/段末端偏移，可圆角化）
                                            选中后变浅绿/浅蓝描边+放大。用 Style 触发器让 StrokeThickness 也能响应。
                                            反向缩放：任何缩放比例下屏幕尺寸恒定。
                                        -->
                                        <Grid Cursor="Hand" RenderTransformOrigin="0.5,0.5" Tag="{Binding Index}">
                                            <Grid.RenderTransform>
                                                <ScaleTransform
                                                    ScaleX="{Binding InverseScale}"
                                                    ScaleY="{Binding InverseScale}" />
                                            </Grid.RenderTransform>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="ToolTip" Value="点击以编辑该接缝的轮廓样式" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCorner}" Value="True">
                                                            <Setter Property="ToolTip" Value="骨线转角点：走骨架转角 join 系统" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCorner}" Value="False">
                                                            <Setter Property="ToolTip" Value="普通轮廓点：可圆角化" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <!--  转角点：蓝色圆点  -->
                                            <Ellipse
                                                Width="5"
                                                Height="5"
                                                Stroke="{StaticResource Brush.Brand.Stroke}"
                                                StrokeThickness="0.15"
                                                Visibility="{Binding IsCorner, Converter={StaticResource BoolToVis}}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Port.Input2}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Brush.State.SuccessLight}" />
                                                                <Setter Property="Stroke" Value="{StaticResource Brush.Port.Input2}" />
                                                                <Setter Property="StrokeThickness" Value="0.4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <!--  普通轮廓点：黄色方块  -->
                                            <Rectangle
                                                Width="3"
                                                Height="3"
                                                Stroke="{StaticResource Brush.Brand.Stroke}"
                                                StrokeThickness="0.15"
                                                Visibility="{Binding IsCorner, Converter={StaticResource InverseBoolToVis}}">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Port.Mid}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Brush.State.SuccessLight}" />
                                                                <Setter Property="Stroke" Value="{StaticResource Brush.Port.Mid}" />
                                                                <Setter Property="StrokeThickness" Value="0.4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                右键框选层：纯视觉（IsHitTestVisible=False 不挡鼠标）。
                                按下右键 → CanvasHost 捕获鼠标，拖动时 code-behind 更新此矩形，
                                松开 → 计算框选矩形 → VM.SelectInRect 加入多选集合。
                                与选区缩放手柄层共享同一坐标系（画布逻辑坐标）。
                            -->
                            <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False" Panel.ZIndex="10010">
                                <Rectangle
                                    x:Name="MarqueeRect"
                                    Width="0"
                                    Height="0"
                                    Visibility="Collapsed"
                                    Fill="{StaticResource Brush.State.AccentFill}"
                                    Stroke="{StaticResource Brush.State.AccentBorder}"
                                    StrokeDashArray="1.5,1.2"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="{Binding StrokeWidthM}" />
                            </Canvas>

                            <!--
                                选区缩放手柄：框选/多选后显示在选集包围盒四角，拖动 = 围绕对角锚点等比缩放。
                                仅在非“主动绘制 / 厚度 / 轮廓编辑”时可见（VM RefreshScaleSelectionHandles 维护）。
                                每个手柄 DataContext = ScaleHandleInfo（Corner/X/Y），中心对齐包围盒角点。
                            -->
                            <ItemsControl
                                x:Name="ScaleHandleHost"
                                IsHitTestVisible="True"
                                ItemsSource="{Binding ScaleSelectionHandles}"
                                PreviewMouseLeftButtonDown="OnScaleHandleMouseDown"
                                PreviewMouseMove="OnScaleHandleMouseMove"
                                PreviewMouseLeftButtonUp="OnScaleHandleMouseUp"
                                Visibility="{Binding HasScaleSelectionHandles, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="10000" />
                                        <Setter Property="Width" Value="3.5" />
                                        <Setter Property="Height" Value="3.5" />
                                        <Setter Property="Margin" Value="-1.75,-1.75,0,0" />
                                        <Style.Triggers>
                                            <!--  四个角的方向光标：NW/SE = SizeNWSE，NE/SW = SizeNESW  -->
                                            <DataTrigger Binding="{Binding Corner}" Value="NW">
                                                <Setter Property="Cursor" Value="SizeNWSE" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Corner}" Value="SE">
                                                <Setter Property="Cursor" Value="SizeNWSE" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Corner}" Value="NE">
                                                <Setter Property="Cursor" Value="SizeNESW" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Corner}" Value="SW">
                                                <Setter Property="Cursor" Value="SizeNESW" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  选区缩放手柄：反向缩放，任何缩放比例下屏幕尺寸恒为 3.5px，中心仍贴包围盒角点。  -->
                                        <Rectangle
                                            Width="3.5"
                                            Height="3.5"
                                            ToolTip="拖拽以等比缩放选中元素"
                                            RenderTransformOrigin="0.5,0.5"
                                            Fill="{StaticResource Brush.State.Accent}"
                                            Stroke="{StaticResource Brush.Brand.Stroke}"
                                            StrokeThickness="0.1">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform
                                                    ScaleX="{Binding InverseScale}"
                                                    ScaleY="{Binding InverseScale}" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </controls:ZoomPanViewport>

                    <!--
                        阵列预览浮层（AutoCAD 式"选中即预览"）：画布右上角轻量面板。
                        类型与参数改动 → 画布预览层实时重建；✓ 确认创建 / ✕ 取消（Esc 同）。
                        三类型：矩形（行列网格，无参考路径）/ 环形（绕圆心圆周）/ 路径（沿折线）。
                        放在画布 chrome 内（ZoomPan 之外）→ 固定屏幕位置，不随画布缩放/平移。
                    -->
                    <Border
                        Margin="8"
                        Padding="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Panel.ZIndex="9000"
                        Background="{StaticResource Brush.Bg.Popup}"
                        BorderBrush="{StaticResource Brush.Port.Output}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding IsPathArrayPreviewOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource Brush.Port.Output}"
                                Text="{Binding ArrayPanelTitle}" />

                            <!--  类型选择  -->
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <TextBlock
                                    Width="56"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource Brush.Text.Primary}"
                                    Text="类型：" />
                                <ComboBox
                                    Width="140"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Brush.Bg.Input}"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    DisplayMemberPath="Label"
                                    FontSize="11"
                                    Foreground="{StaticResource Brush.Text.Primary}"
                                    ItemsSource="{Binding ArrayTypeOptions}"
                                    SelectedItem="{Binding SelectedArrayTypeOption, Mode=TwoWay}" />
                            </StackPanel>

                            <!--  ── 路径阵列参数区（Type == Path）──  -->
                            <StackPanel Visibility="{Binding ArrayPathParamsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                    <TextBlock
                                        Width="56"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="数量：" />
                                    <TextBox
                                        Width="48"
                                        Padding="2,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Bg.Input}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding PathArrayCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{StaticResource Brush.Text.Tertiary}"
                                        Text="(1~100)" />
                                </StackPanel>
                                <CheckBox
                                    Margin="0,0,0,8"
                                    Content="第一份与源重合"
                                    FontSize="11"
                                    Foreground="{StaticResource Brush.Text.Primary}"
                                    IsChecked="{Binding PathArrayIncludeSource, Mode=TwoWay}" />
                            </StackPanel>

                            <!--  ── 矩形阵列参数区（Type == Rectangular）──  -->
                            <StackPanel Visibility="{Binding ArrayRectParamsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                    <TextBlock
                                        Width="56"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="列数：" />
                                    <TextBox
                                        Width="48"
                                        Padding="2,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Bg.Input}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding ArrayPreviewColumns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="行数：" />
                                    <TextBox
                                        Width="48"
                                        Margin="2,0,0,0"
                                        Padding="2,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Bg.Input}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding ArrayPreviewRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <TextBlock
                                        Width="56"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="列距：" />
                                    <TextBox
                                        Width="48"
                                        Padding="2,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Bg.Input}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding ArrayPreviewColSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="行距：" />
                                    <TextBox
                                        Width="48"
                                        Margin="2,0,0,0"
                                        Padding="2,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Bg.Input}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding ArrayPreviewRowSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  ── 环形阵列参数区（Type == Polar）──  -->
                            <StackPanel Visibility="{Binding ArrayPolarParamsVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                    <TextBlock
                                        Width="56"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="数量：" />
                                    <TextBox
                                        Width="48"
                                        Padding="2,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Bg.Input}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding PathArrayCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="填充角：" />
                                    <TextBox
                                        Width="48"
                                        Margin="2,0,0,0"
                                        Padding="2,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Bg.Input}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding ArrayPreviewFillAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{StaticResource Brush.Text.Tertiary}"
                                        Text="°" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                    <TextBlock
                                        Width="56"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="圆心X：" />
                                    <TextBox
                                        Width="48"
                                        Padding="2,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Bg.Input}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding ArrayPreviewCenterX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="圆心Y：" />
                                    <TextBox
                                        Width="48"
                                        Margin="2,0,0,0"
                                        Padding="2,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Bg.Input}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="{Binding ArrayPreviewCenterY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <CheckBox
                                    Margin="0,0,0,8"
                                    Content="副本随圆周旋转（切向对齐）"
                                    FontSize="11"
                                    Foreground="{StaticResource Brush.Text.Primary}"
                                    IsChecked="{Binding ArrayPreviewRotateItems, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <!--  编辑源（C 档）：把阵列源借出为画布上可编辑图元，副本实时跟随（仅选中阵列时显示）  -->
                                <Border
                                    Margin="0,0,6,0"
                                    Padding="10,3"
                                    Background="{StaticResource Brush.Bg.Input}"
                                    BorderBrush="{StaticResource Brush.Border.Mid}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OnArraySourceEditClick"
                                    Visibility="{Binding HasSelectedArray, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="编辑源" />
                                </Border>
                                <Border
                                    Margin="0,0,6,0"
                                    Padding="10,3"
                                    Background="{StaticResource Brush.Bg.SelectedAlt}"
                                    BorderBrush="{StaticResource Brush.Border.Mid}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OnPathArrayCancelClick">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        Text="✕ 取消" />
                                </Border>
                                <Border
                                    Padding="10,3"
                                    Background="{StaticResource Brush.Bg.SuccessSoft}"
                                    BorderBrush="{StaticResource Brush.Border.Success}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OnPathArrayConfirmClick">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Brush.State.SuccessLight}"
                                        Text="{Binding ArrayPanelConfirmText}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  底栏：实时状态信息（CAD 风格：缩放 / 平移 / 视口 / 渲染 / 光标位置）  -->
            <Border
                Grid.Row="2"
                Margin="4,4,4,0"
                Padding="8,4"
                Background="{StaticResource Brush.Bg.Panel}"
                BorderBrush="{StaticResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                CornerRadius="2">
                <StackPanel Orientation="Horizontal">
                    <!--  当前工程文件名（AutoCAD 状态栏信息区）  -->
                    <TextBlock
                        MaxWidth="260"
                        FontSize="10"
                        Foreground="{StaticResource Brush.Text.Secondary}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding WindowTitle}"
                        VerticalAlignment="Center">
                        <Run Text="文件 " /><Run FontWeight="Bold" Text="{Binding WindowTitle, Mode=OneWay}" />
                    </TextBlock>
                    <!--  元素数  -->
                    <TextBlock Margin="12,0,0,0" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center">
                        <Run Text="元素 " /><Run FontWeight="Bold" Text="{Binding ItemCount, Mode=OneWay}" />
                    </TextBlock>
                    <!--  轴对齐（AutoCAD 正交位）  -->
                    <StackPanel Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" Text="轴对齐" />
                        <CheckBox
                            Margin="3,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Brush.Text.Primary}"
                            IsChecked="{Binding AxisSnapEnabled, Mode=TwoWay}" />
                    </StackPanel>
                    <!--  缩放倍率  -->
                    <TextBlock FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center">
                        <Run Text="缩放 " /><Run FontWeight="Bold" Text="{Binding ZoomLevel, Mode=OneWay, StringFormat={}{0:P0}}" />
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" ToolTip="画布在视口内的真实左边距 / 上边距（含自动居中偏移，单位 px）。居中时四周留白，值为正。">
                        <Run Text="平移 " /><Run FontWeight="Bold" Text="{Binding CanvasLeft, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=", " /><Run FontWeight="Bold" Text="{Binding CanvasTop, Mode=OneWay, StringFormat={}{0:0}}" />
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center">
                        <Run Text="视口 " /><Run FontWeight="Bold" Text="{Binding ViewportWidth, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" × " /><Run FontWeight="Bold" Text="{Binding ViewportHeight, Mode=OneWay, StringFormat={}{0:0}}" />
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center">
                        <Run Text="渲染 " /><Run FontWeight="Bold" Text="{Binding RenderWidth, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" × " /><Run FontWeight="Bold" Text="{Binding RenderHeight, Mode=OneWay, StringFormat={}{0:0}}" />
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center">
                        <Run Text="光标 " /><Run FontWeight="Bold" Text="{Binding CursorX, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=", " /><Run FontWeight="Bold" Text="{Binding CursorY, Mode=OneWay, StringFormat={}{0:0}}" />
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" FontSize="10" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" Text="提示：从左侧 L1 / L2 工具栏拖入图形到右侧画布，点击图形可选中，工具栏可删除选中或全部清空。" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  右侧：属性 / 元素 两页（抽屉式：窄把手 + 可伸缩内容区。元素页用于排查画布上不可见的多余元素）  -->
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <!--
                    内层两列都设 Auto：内容列实际宽度由 Border 宽度动画驱动（240↔0），
                    列宽随之收缩 → 外层 Auto 列同步收缩 → 画布伸展。若内容列固定 240，
                    动画收缩后列仍占 240，抽屉缩不回去。
                -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                抽屉把手：垂直窄条，点击展开/收起面板（Chevron 指示收起后的展开动作方向；
                宽度伸缩动画由 code-behind 的 Checked/Unchecked 驱动——DataTrigger EnterActions
                里的 BeginStoryboard 交替播放会因 HoldEnd 值残留而"缩得回、展不开"）。
            -->
            <ToggleButton
                x:Name="RightPaneToggle"
                Grid.Column="0"
                MinWidth="26"
                Margin="4,0,0,0"
                VerticalAlignment="Stretch"
                Background="{StaticResource Brush.Bg.Panel}"
                BorderBrush="{StaticResource Brush.Border.Subtle}"
                BorderThickness="1,1,0,1"
                Checked="OnRightPaneToggleChecked"
                Cursor="Hand"
                IsChecked="True"
                ToolTip="展开 / 收起属性面板"
                Unchecked="OnRightPaneToggleUnchecked">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4,0,0,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </ToggleButton.Template>
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Foreground="{StaticResource Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!--  收起（IsChecked=False）→ 箭头指向左，提示"向左侧展开"  -->
                            <Setter Property="Text" Value="&#xE76F;" />
                            <Style.Triggers>
                                <!--  展开（IsChecked=True）→ 箭头指向右，提示"向右折叠"  -->
                                <DataTrigger Binding="{Binding IsChecked, ElementName=RightPaneToggle}" Value="True">
                                    <Setter Property="Text" Value="&#xE76E;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </ToggleButton>

            <!--
                面板内容区：宽度动画伸缩的抽屉（收起 → 240→0 收缩、内容被 ClipToBounds 裁切；
                展开 → 0→240 滑出。宽度动画由 code-behind Checked/Unchecked（BeginAnimation）驱动）。
            -->
            <Border
                x:Name="RightPaneBorder"
                Grid.Column="1"
                Width="240"
                Margin="0,0,0,0"
                Background="{StaticResource Brush.Bg.Panel}"
                BorderBrush="{StaticResource MetalFrameInner}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="4">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,6"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{StaticResource Brush.Text.Muted}"
                        Text="面板" />

                    <!--  页切换器：属性 / 元素（复刻三模式按钮：ItemsControl + UniformGrid 两列，DataTrigger 切选中色）  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,6"
                        Background="{StaticResource Brush.Bg.Darker}"
                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <ItemsControl ItemsSource="{Binding RightPaneChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Padding="0,4"
                                        Background="{StaticResource Brush.Bg.Transparent}"
                                        BorderThickness="0"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding CommandParameter}"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    Padding="6,4"
                                                    Background="{TemplateBinding Background}"
                                                    Cursor="Hand">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource Brush.Bg.Transparent}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Bg.SuccessSoft}" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.State.SuccessLight}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock FontSize="10" Text="{Binding Label}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.State.SuccessLight}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!--  页面内容区：属性页 / 元素页 互斥显示  -->
                    <Grid Grid.Row="2">
                        <!--  ═══ 属性页（原右侧属性栏内容） ═══  -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsPropertiesPaneVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!--  扇形属性组（仅 Pie 时显示）：起始角（旋转）+ 扫掠角（夹角）。放最顶部，选中扇形时第一个出现。  -->
                                <StackPanel
                                    Margin="0,0,0,6"
                                    Visibility="{Binding SelectedItemIsPie, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                        Text="扇形属性" />
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{StaticResource Brush.Text.Primary}"
                                            Text="起始角（旋转）" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{StaticResource Brush.Text.Tertiary}"
                                            Text="{Binding SelectedItem.StartAngle, Mode=OneWay, StringFormat={}{0:0.#}°}" />
                                    </Grid>
                                    <controls:SliderSpinBox
                                        IsSnapToTickEnabled="True"
                                        LargeChange="10"
                                        Maximum="360"
                                        Minimum="0"
                                        Step="1"
                                        StringFormat="{}{0:0.#}°"
                                        Value="{Binding SelectedItem.StartAngle, Mode=TwoWay}" />
                                    <Grid Margin="0,8,0,2">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{StaticResource Brush.Text.Primary}"
                                            Text="扫掠角（夹角）" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{StaticResource Brush.Text.Tertiary}"
                                            Text="{Binding SelectedItem.SweepAngle, Mode=OneWay, StringFormat={}{0:0.#}°}" />
                                    </Grid>
                                    <controls:SliderSpinBox
                                        IsSnapToTickEnabled="True"
                                        LargeChange="10"
                                        Maximum="360"
                                        Minimum="1"
                                        Step="1"
                                        StringFormat="{}{0:0.#}°"
                                        Value="{Binding SelectedItem.SweepAngle, Mode=TwoWay}" />
                                </StackPanel>
                                <!--
                                    画布背景颜色(画布级全局设置,与选中元素无关):SwatchesPicker 改背景色 + 重置按钮。
                                    CanvasHost.Background 绑 VM.CanvasBackgroundBrush,改色即时生效。
                                    画布背景色可切浅色(如白),便于查看深色导入元素。
                                -->
                                <Border
                                    Margin="0,0,0,4"
                                    Padding="6"
                                    Background="{StaticResource Brush.Bg.Darker}"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource Brush.Text.Muted}"
                                                Text="画布背景" />
                                            <Button
                                                HorizontalAlignment="Right"
                                                Padding="4,0"
                                                Background="{StaticResource Brush.Bg.Transparent}"
                                                BorderThickness="0"
                                                Command="{Binding ResetCanvasBackgroundCommand}"
                                                Cursor="Hand"
                                                FontSize="9"
                                                Foreground="{StaticResource Brush.State.Accent}"
                                                Content="重置" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{StaticResource Brush.Text.Secondary}"
                                                Text="背景色" />
                                            <controls:SwatchesPicker
                                                Grid.Column="1"
                                                Width="92"
                                                MoreColorsRequested="OnSwatchesPickerMoreColors"
                                                PickerRequested="OnSwatchesPickerPickerRequested"
                                                RecentColors="{Binding DataContext.RecentColorings, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                SelectedColor="{Binding CanvasBackgroundColor, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!--
                                    通用透明度：任何元素选中时都显示,放在最顶部作为公共属性。
                                    与"背景透明度"工具栏项语义独立：这里是绘制层单个元素的可见度。
                                    关键:即使选中元素是 L1Line/L1Ellipse/L1Triangle 等之前不显示属性面板的类型,
                                    现在也能通过这个 Border 调透明度。
                                -->
                                <Border
                                    Margin="0,0,0,4"
                                    Padding="6"
                                    Background="{StaticResource Brush.Bg.Darker}"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                Text="透明度" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{StaticResource Brush.Text.Tertiary}">
                                                <Run Text="{Binding SelectedItem.Opacity, Mode=OneWay, StringFormat=P0}" />
                                            </TextBlock>
                                        </Grid>
                                        <!--  范围 0.05~1.0(下限避免完全看不见),步长 0.05  -->
                                        <controls:SliderSpinBox
                                            Maximum="1.0"
                                            Minimum="0.05"
                                            Step="0.05"
                                            StringFormat="{}{0:0.##}"
                                            Value="{Binding SelectedItem.Opacity, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>

                                <!--  ═══ 外观：线条 / 填充 / 阴影 三大属性组（任意图元通用；阴影暂留空） ═══  -->
                                <Border
                                    Margin="0,4,0,4"
                                    Padding="6"
                                    Background="{StaticResource Brush.Bg.Darker}"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <!--  ── 1. 线条 ──  -->
                                        <Border
                                            Margin="0,0,0,4"
                                            Padding="6"
                                            Background="{StaticResource Brush.Bg.Darker}"
                                            BorderBrush="{StaticResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource Brush.Text.Muted}"
                                                    Text="线条" />
                                                <!--  粗细  -->
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                                        Text="粗细" />
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Tertiary}">
                                                        <Run Text="{Binding SelectedItem.StrokeWidth, StringFormat={}{0:0.#}}" />
                                                    </TextBlock>
                                                </Grid>
                                                <controls:SliderSpinBox
                                                    Maximum="10"
                                                    Minimum="0.1"
                                                    Step="0.1"
                                                    StringFormat="{}{0:0.#}"
                                                    Value="{Binding SelectedItem.StrokeWidth, Mode=TwoWay}" />
                                                <!--  虚线  -->
                                                <Grid Margin="0,6,0,0">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                                        Text="虚线" />
                                                    <ComboBox
                                                        Width="96"
                                                        HorizontalAlignment="Right"
                                                        Background="{StaticResource Brush.Bg.Input}"
                                                        BorderBrush="{StaticResource Brush.Border.Mid}"
                                                        DisplayMemberPath="Label"
                                                        Foreground="{StaticResource Brush.Text.Primary}"
                                                        ItemsSource="{Binding StrokeDashOptions}"
                                                        SelectedValue="{Binding SelectedItem.StrokeDashStyle, Mode=TwoWay}"
                                                        SelectedValuePath="Value" />
                                                </Grid>
                                                <!--  颜色  -->
                                                <Grid Margin="0,6,0,0">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                                        Text="颜色" />
                                                    <controls:SwatchesPicker
                                                        Width="92"
                                                        HorizontalAlignment="Right"
                                                        MoreColorsRequested="OnSwatchesPickerMoreColors"
                                                        PickerRequested="OnSwatchesPickerPickerRequested"
                                                        RecentColors="{Binding DataContext.RecentColorings, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedColor="{Binding SelectedItem.StrokeColor, Mode=TwoWay}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!--  ── 2. 填充 ──  -->
                                        <!--
                                            按用户设计参考图重做：
                                              顶部 6 个 RadioButton 单选（无/单色/渐变/单色渐变/图案/图片）
                                              下方按方式显示"颜色"或"起止色"SwatchesPicker
                                              再下方"亮度"+"透明度"Slider+数值（对所有非 None 方式生效）
                                            Pattern/ImageTexture 当前 UI 框架就位,具体渲染后续迭代——
                                              选中后下方色板/Slider 灰显,提示"待实现"。
                                        -->
                                        <Border
                                            Margin="0,0,0,4"
                                            Padding="6"
                                            Background="{StaticResource Brush.Bg.Darker}"
                                            BorderBrush="{StaticResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource Brush.Text.Muted}"
                                                    Text="填充" />

                                                <!--  ── 方式：6 个 RadioButton 单选  ──  -->
                                                <!--  直接写 6 个 RadioButton（枚举固定，无需 ItemsControl 动态化）。
                                                     GroupName="FillStyleGroup" 强制互斥;EnumEqualsConverter 判断 SelectedItem.FillStyle
                                                     与本 RadioButton 的 ConverterParameter 是否相等,相等 → 选中;
                                                     用户点别的 RadioButton → Converter 回写新枚举值到 SelectedItem.FillStyle。  -->
                                                <RadioButton
                                                    Margin="0,1,0,1"
                                                    VerticalAlignment="Center"
                                                    Content="无填充"
                                                    FontSize="10"
                                                    Foreground="{StaticResource Brush.Text.Primary}"
                                                    GroupName="FillStyleGroup"
                                                    IsChecked="{Binding SelectedItem.FillStyle, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:FillStyle.None}}" />
                                                <RadioButton
                                                    Margin="0,1,0,1"
                                                    VerticalAlignment="Center"
                                                    Content="单色填充"
                                                    FontSize="10"
                                                    Foreground="{StaticResource Brush.Text.Primary}"
                                                    GroupName="FillStyleGroup"
                                                    IsChecked="{Binding SelectedItem.FillStyle, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:FillStyle.Solid}}" />
                                                <RadioButton
                                                    Margin="0,1,0,1"
                                                    VerticalAlignment="Center"
                                                    Content="渐变填充"
                                                    FontSize="10"
                                                    Foreground="{StaticResource Brush.Text.Primary}"
                                                    GroupName="FillStyleGroup"
                                                    IsChecked="{Binding SelectedItem.FillStyle, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:FillStyle.Gradient}}" />
                                                <RadioButton
                                                    Margin="0,1,0,1"
                                                    VerticalAlignment="Center"
                                                    Content="单色渐变填充"
                                                    FontSize="10"
                                                    Foreground="{StaticResource Brush.Text.Primary}"
                                                    GroupName="FillStyleGroup"
                                                    IsChecked="{Binding SelectedItem.FillStyle, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:FillStyle.MonochromeGradient}}" />
                                                <RadioButton
                                                    Margin="0,1,0,1"
                                                    VerticalAlignment="Center"
                                                    Content="图案填充"
                                                    FontSize="10"
                                                    Foreground="{StaticResource Brush.Text.Primary}"
                                                    GroupName="FillStyleGroup"
                                                    IsChecked="{Binding SelectedItem.FillStyle, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:FillStyle.Pattern}}"
                                                    IsEnabled="{Binding SelectedItem.IsFillable}" />
                                                <RadioButton
                                                    Margin="0,1,0,1"
                                                    VerticalAlignment="Center"
                                                    Content="图片或纹理填充"
                                                    FontSize="10"
                                                    Foreground="{StaticResource Brush.Text.Primary}"
                                                    GroupName="FillStyleGroup"
                                                    IsChecked="{Binding SelectedItem.FillStyle, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:FillStyle.ImageTexture}}" />

                                                <!--  ── 颜色（Solid / MonochromeGradient 时显示） ──  -->
                                                <Grid Margin="0,2,0,4">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.Solid}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.MonochromeGradient}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                                        Text="颜色" />
                                                    <controls:SwatchesPicker
                                                        Grid.Column="1"
                                                        Width="92"
                                                        ClearFillRequested="OnFillColorClearFillRequested"
                                                        MoreColorsRequested="OnSwatchesPickerMoreColors"
                                                        PickerRequested="OnSwatchesPickerPickerRequested"
                                                        RecentColors="{Binding DataContext.RecentColorings, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedColor="{Binding SelectedItem.FillColor, Mode=TwoWay}" />
                                                </Grid>

                                                <!--  ── 渐变起止色（Gradient 时显示） ──  -->
                                                <StackPanel Margin="0,2,0,4">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.Gradient}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="起始色" />
                                                        <controls:SwatchesPicker
                                                            Grid.Column="1"
                                                            Width="92"
                                                            MoreColorsRequested="OnSwatchesPickerMoreColors"
                                                            PickerRequested="OnSwatchesPickerPickerRequested"
                                                            RecentColors="{Binding DataContext.RecentColorings, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            SelectedColor="{Binding SelectedItem.GradientStartColor, Mode=TwoWay}" />
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="结束色" />
                                                        <controls:SwatchesPicker
                                                            Grid.Column="1"
                                                            Width="92"
                                                            MoreColorsRequested="OnSwatchesPickerMoreColors"
                                                            PickerRequested="OnSwatchesPickerPickerRequested"
                                                            RecentColors="{Binding DataContext.RecentColorings, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            SelectedColor="{Binding SelectedItem.GradientEndColor, Mode=TwoWay}" />
                                                    </Grid>
                                                </StackPanel>

                                                <!--  ── 单色渐变提示（MonochromeGradient 时显示一行小字） ──  -->
                                                <TextBlock
                                                    Margin="0,-2,0,4"
                                                    FontSize="9"
                                                    Foreground="{StaticResource Brush.Text.Tertiary}"
                                                    Text="结束色按所选颜色自动加深派生">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.MonochromeGradient}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!--  ── 图案填充控件区（仅 FillStyle=Pattern 时显示；开放图元通过上方的图案 RadioButton IsEnabled 拦截，
                         此处的图案分支无需再校验 IsFillable，避免依赖未注册的 AndConverter） ──  -->
                                                <StackPanel Margin="0,2,0,4">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.Pattern}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <!--  图案样式（4 个 RadioButton 单选，和 FillStyle 选择风格一致）  -->
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="图案" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <RadioButton
                                                                VerticalAlignment="Center"
                                                                Content="斜线"
                                                                FontSize="9"
                                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                                GroupName="PatternStyleGroup"
                                                                IsChecked="{Binding SelectedItem.PatternStyle, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PatternStyle.Diagonal}}" />
                                                            <RadioButton
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Content="水平"
                                                                FontSize="9"
                                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                                GroupName="PatternStyleGroup"
                                                                IsChecked="{Binding SelectedItem.PatternStyle, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PatternStyle.Horizontal}}" />
                                                            <RadioButton
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Content="竖直"
                                                                FontSize="9"
                                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                                GroupName="PatternStyleGroup"
                                                                IsChecked="{Binding SelectedItem.PatternStyle, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PatternStyle.Vertical}}" />
                                                            <RadioButton
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Content="网格"
                                                                FontSize="9"
                                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                                GroupName="PatternStyleGroup"
                                                                IsChecked="{Binding SelectedItem.PatternStyle, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PatternStyle.Cross}}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!--  平铺尺寸 4~40  -->
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="平铺" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <controls:SliderSpinBox
                                                                Maximum="40"
                                                                Minimum="4"
                                                                Step="1"
                                                                StringFormat="{}{0:0}px"
                                                                Value="{Binding SelectedItem.PatternTileSize, Mode=TwoWay}" />
                                                            <Border
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Padding="6,1"
                                                                BorderBrush="{StaticResource Brush.Border.Mid}"
                                                                BorderThickness="1"
                                                                CornerRadius="2">
                                                                <TextBlock
                                                                    FontSize="9"
                                                                    Foreground="{StaticResource Brush.Text.Primary}"
                                                                    Text="{Binding SelectedItem.PatternTileSize, StringFormat={}{0:0}px}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!--  密度（线间距 1~40，越大越疏）  -->
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="密度" />
                                                        <controls:SliderSpinBox
                                                            Grid.Column="1"
                                                            Maximum="40"
                                                            Minimum="1"
                                                            Step="1"
                                                            StringFormat="{}{0:0}px"
                                                            Value="{Binding SelectedItem.PatternSpacing, Mode=TwoWay}" />
                                                    </Grid>

                                                    <!--  前景色（画图案线的颜色）  -->
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="前景" />
                                                        <controls:SwatchesPicker
                                                            Grid.Column="1"
                                                            Width="92"
                                                            MoreColorsRequested="OnSwatchesPickerMoreColors"
                                                            PickerRequested="OnSwatchesPickerPickerRequested"
                                                            RecentColors="{Binding DataContext.RecentColorings, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            SelectedColor="{Binding SelectedItem.PatternForeground, Mode=TwoWay}" />
                                                    </Grid>

                                                    <!--  前景亮度 + 透明度  -->
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="亮度" />
                                                        <controls:SliderSpinBox
                                                            Grid.Column="1"
                                                            Maximum="100"
                                                            Minimum="0"
                                                            Step="1"
                                                            StringFormat="{}{0:0}%"
                                                            Value="{Binding SelectedItem.PatternForegroundBrightness, Mode=TwoWay}" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="透明度" />
                                                        <controls:SliderSpinBox
                                                            Grid.Column="1"
                                                            Maximum="100"
                                                            Minimum="0"
                                                            Step="1"
                                                            StringFormat="{}{0:0}%"
                                                            Value="{Binding SelectedItem.PatternForegroundOpacity, Mode=TwoWay}" />
                                                    </Grid>

                                                    <!--  背景色（图案底色）  -->
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="背景" />
                                                        <controls:SwatchesPicker
                                                            Grid.Column="1"
                                                            Width="92"
                                                            MoreColorsRequested="OnSwatchesPickerMoreColors"
                                                            PickerRequested="OnSwatchesPickerPickerRequested"
                                                            RecentColors="{Binding DataContext.RecentColorings, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            SelectedColor="{Binding SelectedItem.PatternBackground, Mode=TwoWay}" />
                                                    </Grid>

                                                    <!--  背景亮度 + 透明度  -->
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="亮度" />
                                                        <controls:SliderSpinBox
                                                            Grid.Column="1"
                                                            Maximum="100"
                                                            Minimum="0"
                                                            Step="1"
                                                            StringFormat="{}{0:0}%"
                                                            Value="{Binding SelectedItem.PatternBackgroundBrightness, Mode=TwoWay}" />
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Secondary}"
                                                            Text="透明度" />
                                                        <controls:SliderSpinBox
                                                            Grid.Column="1"
                                                            Maximum="100"
                                                            Minimum="0"
                                                            Step="1"
                                                            StringFormat="{}{0:0}%"
                                                            Value="{Binding SelectedItem.PatternBackgroundOpacity, Mode=TwoWay}" />
                                                    </Grid>
                                                </StackPanel>

                                                <!--  ── 图片或纹理填充（ImageTexture）当前未实现，保留占位提示 ──  -->
                                                <Border
                                                    Margin="0,2,0,4"
                                                    Padding="6,4"
                                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Background" Value="{StaticResource Brush.Bg.Base}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.ImageTexture}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        FontSize="9"
                                                        Foreground="{StaticResource Brush.Text.Tertiary}"
                                                        TextWrapping="Wrap"
                                                        Text="图片或纹理填充 — 导入逻辑后续迭代实现。" />
                                                </Border>

                                                <!--  ── 亮度 Slider（所有非 None 方式生效；Pattern/ImageTexture 暂禁用） ──  -->
                                                <Grid Margin="0,4,0,2">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Opacity" Value="0.5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.Solid}">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.Gradient}">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.MonochromeGradient}">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                                        Text="亮度" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <controls:SliderSpinBox
                                                            Maximum="100"
                                                            Minimum="0"
                                                            Step="1"
                                                            StringFormat="{}{0:0}%"
                                                            Value="{Binding SelectedItem.FillBrightness, Mode=TwoWay}" />
                                                        <Border
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Padding="6,1"
                                                            BorderBrush="{StaticResource Brush.Border.Mid}"
                                                            BorderThickness="1"
                                                            CornerRadius="2">
                                                            <TextBlock
                                                                FontSize="9"
                                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                                Text="{Binding SelectedItem.FillBrightness, StringFormat={}{0:0}%}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!--  ── 透明度 Slider（同上） ──  -->
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Opacity" Value="0.5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.Solid}">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.Gradient}">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedItem.FillStyle}" Value="{x:Static models:FillStyle.MonochromeGradient}">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Secondary}"
                                                        Text="透明度" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <controls:SliderSpinBox
                                                            Maximum="100"
                                                            Minimum="0"
                                                            Step="1"
                                                            StringFormat="{}{0:0}%"
                                                            Value="{Binding SelectedItem.FillOpacity, Mode=TwoWay}" />
                                                        <Border
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Padding="6,1"
                                                            BorderBrush="{StaticResource Brush.Border.Mid}"
                                                            BorderThickness="1"
                                                            CornerRadius="2">
                                                            <TextBlock
                                                                FontSize="9"
                                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                                Text="{Binding SelectedItem.FillOpacity, StringFormat={}{0:0}%}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!--  ── 3. 阴影（暂留空） ──  -->
                                        <Border
                                            Padding="6"
                                            Background="{StaticResource Brush.Bg.Darker}"
                                            BorderBrush="{StaticResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,2"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource Brush.Text.Muted}"
                                                    Text="阴影" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource Brush.Text.Tertiary}"
                                                    Text="（暂未开放）" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!--  属性面板：仅当选中的是矩形类（Rectangle / RoundedRectangle）/ BandPolyline / Polyline 时显示  -->
                                <Border
                                    Padding="6"
                                    Background="{StaticResource Brush.Bg.Darker}"
                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItemIsRect}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedItemIsBandPolyline}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedItemIsPolyline}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedItemIsBooleanPath}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!--
                                            布尔运算结果属性组（仅 BooleanPath 时显示）：多环骨架快照，与闭合 Polyline 同一编辑管道——
                                            骨架模式拖顶点、轮廓模式逐点设圆角。
                                        -->
                                        <StackPanel Visibility="{Binding SelectedItemIsBooleanPath, Converter={StaticResource BoolToVis}}">
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource Brush.Text.Muted}"
                                                Text="布尔运算结果" />
                                            <Border
                                                Margin="0,2,0,6"
                                                Background="{StaticResource Brush.Bg.Darker}"
                                                BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <Button
                                                    Padding="6,4"
                                                    Background="{StaticResource Brush.Bg.Transparent}"
                                                    BorderThickness="0"
                                                    Command="{Binding ToggleEditModeCommand}"
                                                    Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                Padding="6,4"
                                                                Background="{TemplateBinding Background}"
                                                                Cursor="Hand">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutlineEditMode}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.State.SuccessLight}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock FontSize="10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="编辑骨架点（轮廓点不可拖拽）" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOutlineEditMode}" Value="True">
                                                                        <Setter Property="Text" Value="编辑轮廓（选中轮廓点设样式 / 圆角）" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </Border>
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="10"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                Text="由两个闭合图元合并/剪除/相交得到。轮廓点不允许拖拽；轮廓模式下点击轮廓点可设置该点样式（Miter 尖角 / Round 圆角）及圆角半径（0=尖角，&gt;0=圆角）。结果仍可再次参与布尔运算。"
                                                TextWrapping="Wrap" />
                                            <!--  源快照 + 调整/重新合并：合并时源几何已烧入结果；点"调整源"按快照恢复到画布编辑  -->
                                            <Border
                                                Margin="0,2,0,6"
                                                Background="{StaticResource Brush.Bg.Darker}"
                                                BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <StackPanel>
                                                    <Button
                                                        Padding="6,4"
                                                        Background="{StaticResource Brush.Bg.Transparent}"
                                                        BorderThickness="0"
                                                        Command="{Binding ToggleSourceAdjustCommand}"
                                                        Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border
                                                                    Padding="6,4"
                                                                    Background="{TemplateBinding Background}"
                                                                    Cursor="Hand">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.State.SuccessLight}" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock FontSize="10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="调整源（临时显示源图形进行编辑）" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSourceAdjustMode}" Value="True">
                                                                            <Setter Property="Text" Value="收起源（保持当前结果不变）" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button
                                                        Margin="0,2,0,0"
                                                        Padding="6,4"
                                                        Background="{StaticResource Brush.Bg.Transparent}"
                                                        BorderThickness="0"
                                                        Command="{Binding RecomputeBooleanCommand}"
                                                        Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border
                                                                    Padding="6,4"
                                                                    Background="{TemplateBinding Background}"
                                                                    Cursor="Hand">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.State.SuccessLight}" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock FontSize="10" Text="重新合并（按源当前几何重算，并自动收起源）" />
                                                    </Button>
                                                    <TextBlock
                                                        Margin="6,0,6,4"
                                                        FontSize="9"
                                                        Foreground="{StaticResource Brush.Text.Muted}"
                                                        Text="点&#x201C;调整源&#x201D;按快照把两个源恢复到画布（结果半透明作参考）。拖动/改尺寸源：结果实时预览；松开鼠标自动重新合并并收起源。可手动点&#x201C;收起源&#x201D;（保持当前结果）或&#x201C;重新合并&#x201D;（按最新源几何烧入结果）。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <!--  轮廓模式：接缝样式 + 圆角半径（布尔自己的轮廓属性面板，不借用 BandPolyline）  -->
                                            <StackPanel Margin="0,2,0,0" Visibility="{Binding IsOutlineEditMode, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Primary}"
                                                        Text="接缝样式" />
                                                    <ComboBox
                                                        Width="110"
                                                        HorizontalAlignment="Right"
                                                        Background="{StaticResource Brush.Bg.InputDeep}"
                                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                        FontSize="11"
                                                        Foreground="{StaticResource Brush.Text.Primary}"
                                                        IsEnabled="{Binding HasSelectedOutlineCorner}"
                                                        SelectedItem="{Binding SelectedOutlineCorner.CurrentStyleEffective, Mode=TwoWay}">
                                                        <models:JoinStyle>Miter</models:JoinStyle>
                                                        <models:JoinStyle>Round</models:JoinStyle>
                                                    </ComboBox>
                                                </Grid>
                                                <Grid Margin="0,2,0,0">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Primary}"
                                                        Text="圆角半径" />
                                                    <controls:SliderSpinBox
                                                        HorizontalAlignment="Right"
                                                        IsSnapToTickEnabled="True"
                                                        Maximum="20"
                                                        Minimum="0"
                                                        Step="0.5"
                                                        StringFormat="{}{0:0.#}"
                                                        ValueChanged="OnCornerRadiusSliderValueChanged"
                                                        Value="{Binding SelectedOutlineCorner.CurrentRadius, Mode=OneWay, TargetNullValue=0}">
                                                        <controls:SliderSpinBox.Style>
                                                            <Style TargetType="controls:SliderSpinBox">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasSelectedOutlineCorner}" Value="True" />
                                                                            <Condition Binding="{Binding SelectedOutlineCorner.CurrentStyleEffective}" Value="{x:Static models:JoinStyle.Round}" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="True" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:SliderSpinBox.Style>
                                                    </controls:SliderSpinBox>
                                                </Grid>
                                            </StackPanel>
                                            <!--  轮廓点诊断列表：每环每点 序号/坐标/距前点距离，排查"奇怪的重合点"  -->
                                            <Expander
                                                Margin="0,6,0,0"
                                                FontSize="10"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                Header="轮廓点列表（诊断）"
                                                IsExpanded="False">
                                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                    <TextBlock
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Diagnostic}"
                                                        Text="{Binding SelectedBooleanSkeletonInfo}"
                                                        TextWrapping="NoWrap" />
                                                </ScrollViewer>
                                            </Expander>
                                        </StackPanel>
                                        <!--  矩形属性组（仅矩形时显示）  -->
                                        <StackPanel Visibility="{Binding SelectedItemIsRect, Converter={StaticResource BoolToVis}}">
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource Brush.Text.Muted}"
                                                Text="矩形属性" />

                                            <!--  圆角半径 CornerRadius  -->
                                            <StackPanel Margin="0,2,0,2">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Primary}"
                                                        Text="圆角" />
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Brush.Text.Tertiary}">
                                                        <Run Text="{Binding SelectedItem.CornerRadius, Mode=OneWay, StringFormat=F1}" />
                                                        <Run Text=" / 最大 " />
                                                        <Run Text="{Binding SelectedCornerRadiusMax, Mode=OneWay, StringFormat=F1}" />
                                                    </TextBlock>
                                                </Grid>
                                                <controls:SliderSpinBox
                                                    x:Name="CornerSlider"
                                                    LargeChange="1"
                                                    Maximum="{Binding SelectedCornerRadiusMax}"
                                                    Minimum="0"
                                                    Step="0.1"
                                                    StringFormat="{}{0:0.#}"
                                                    Value="{Binding SelectedItem.CornerRadius, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--
                                            纯折线属性组（仅 Polyline 时显示）：与 BandPolyline 的区别=无带宽/无轮廓控制。
                                            仅显示类型说明，不暴露带宽 Slider / 轮廓编辑模式（避免与兄弟类型混淆）。
                                            顶点编辑与 BandPolyline 共用：画布手柄拖动改 PathData，无需面板控件。
                                        -->
                                        <StackPanel Visibility="{Binding SelectedItemIsPolyline, Converter={StaticResource BoolToVis}}">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource Brush.Text.Muted}"
                                                Text="折线属性" />
                                            <!--  闭合形状开关：勾选后骨架点直连单环 → 可填充的闭合多边形，每骨架点可设圆角半径  -->
                                            <CheckBox
                                                Margin="0,2,0,4"
                                                VerticalAlignment="Center"
                                                Content="闭合形状（可填充多边形）"
                                                FontSize="10"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                IsChecked="{Binding SelectedItem.IsClosed, Mode=TwoWay}" />
                                            <!--  闭合后进入轮廓编辑模式（Round/Miter/半径）：复用带状折线的轮廓分支  -->
                                            <StackPanel Margin="0,2,0,0" Visibility="{Binding SelectedItem.IsClosed, Converter={StaticResource BoolToVis}}">
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Background="{StaticResource Brush.Bg.Darker}"
                                                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <Button
                                                        Padding="6,4"
                                                        Background="{StaticResource Brush.Bg.Transparent}"
                                                        BorderThickness="0"
                                                        Command="{Binding ToggleEditModeCommand}"
                                                        Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border
                                                                    Padding="6,4"
                                                                    Background="{TemplateBinding Background}"
                                                                    Cursor="Hand">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOutlineEditMode}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.State.SuccessLight}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock FontSize="10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="编辑骨架点（描边/顶点）" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOutlineEditMode}" Value="True">
                                                                            <Setter Property="Text" Value="编辑轮廓（圆角 / Miter）" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="10"
                                                Foreground="{StaticResource Brush.Text.Primary}"
                                                Text="开放形态：仅骨架描边，无填充。勾选闭合形状后，骨架点首尾相接形成可填充多边形；进入轮廓编辑可对每个骨架点设置圆角半径（0=尖角 Miter，&gt;0=圆角 Round）。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        

                                        <!--  带状折线属性组（仅 BandPolyline 时显示）  -->
                                        <StackPanel Visibility="{Binding SelectedItemIsBandPolyline, Converter={StaticResource BoolToVis}}">
                                            <!--  阶段 4：标题按模式换文字（Skeleton / BandWidth / Outline）  -->
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource Brush.Text.Muted}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="带状折线属性" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBandWidthEditMode}" Value="True">
                                                                <Setter Property="Text" Value="带宽属性" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOutlineEditMode}" Value="True">
                                                                <Setter Property="Text" Value="轮廓属性" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!--
                                                编辑模式段切换器：骨架 / 带宽 / 轮廓（阶段 2：ItemsControl + UniformGrid 三列等宽，省掉三段复制）。
                                                外层 Border 提供整体圆角 + 描边；内层每项 Button 用 DataTrigger 切选中色。
                                            -->
                                            <Border
                                                Margin="0,0,0,6"
                                                Background="{StaticResource Brush.Bg.Darker}"
                                                BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <ItemsControl ItemsSource="{Binding EditModeChoices}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="3" Rows="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Padding="0,4"
                                                                Background="{StaticResource Brush.Bg.Transparent}"
                                                                BorderThickness="0"
                                                                Command="{Binding Command}"
                                                                CommandParameter="{Binding CommandParameter}"
                                                                Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border
                                                                            Padding="6,4"
                                                                            Background="{TemplateBinding Background}"
                                                                            Cursor="Hand">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="{StaticResource Brush.Bg.Transparent}" />
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource Brush.Bg.SuccessSoft}" />
                                                                                <Setter Property="Foreground" Value="{StaticResource Brush.State.SuccessLight}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock FontSize="10" Text="{Binding Label}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.State.SuccessLight}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>

                                            <!--
                                                ===== 阶段 4：属性面板三模式互斥显示 =====
                                                各模式归属待后续讨论调整；本阶段先按"现状严格分流"原样迁入。
                                                带宽线模式占位段：列出每段两端点的当前带宽（只读，本阶段无编辑控件）。
                                            -->

                                            <!--  骨架模式：仅动骨架顶点拖拽 / PathData；带宽调整全部归带宽模式  -->
                                            <StackPanel Visibility="{Binding IsSkeletonEditMode, Converter={StaticResource BoolToVis}}">
                                                <!--
                                                    骨架几何配置：共线同向时的轮廓点拆分行为，由骨架形态决定 → 归骨架模式。
                                                    勾选=两对轮廓点（保留带宽突变台阶，可逐侧圆角）；不勾选=合并为一对（忽略台阶）。
                                                -->
                                                <CheckBox
                                                    Content="共线同向时合并连接点"
                                                    FontSize="10"
                                                    Foreground="{StaticResource Brush.Text.Primary}"
                                                    IsChecked="{Binding SelectedItem.CollinearSplitPairs, Mode=TwoWay}"
                                                    ToolTip="骨线两段共线同方向时的轮廓点数量：勾选=保留两对（带宽突变台阶，可逐侧圆角）；不勾选=合并为一对（忽略台阶）。本项属于骨架几何配置。" />
                                            </StackPanel>

                                            <!--  带宽模式：全局带宽（独立分组）+ 骨点列表（树状结构）  -->
                                            <StackPanel Visibility="{Binding IsBandWidthEditMode, Converter={StaticResource BoolToVis}}">
                                                <!--  全局带宽：拖动时同步所有顶点 Incoming+Outgoing（统一调整）。  -->
                                                <StackPanel Margin="0,2,0,2">
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Primary}"
                                                            Text="带宽" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Tertiary}">
                                                            <Run Text="{Binding SelectedItem.BandWidth, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                                            <Run Text=" / " />
                                                            <Run Text="{Binding SelectedBandWidthMax, Mode=OneWay, StringFormat=F0}" />
                                                        </TextBlock>
                                                    </Grid>
                                                    <!--  全局带宽下限 0：带宽归零时整条轮廓退化为纯折线骨架  -->
                                                    <controls:SliderSpinBox
                                                        LargeChange="1"
                                                        Maximum="{Binding SelectedBandWidthMax, Mode=OneWay, FallbackValue=30}"
                                                        Minimum="0"
                                                        Step="0.1"
                                                        StringFormat="{}{0:0.#}"
                                                        Value="{Binding SelectedItem.BandWidth, Mode=TwoWay}" />
                                                    <!--  取值范围 ×2/÷2：对数缩放上限。带宽远小于上限时 ÷2 收窄让滑块更好微调，×2 放大。  -->
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="9"
                                                            Foreground="{StaticResource Brush.Text.Tertiary}"
                                                            Text="调整范围" />
                                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                            <Button
                                                                Height="18"
                                                                Margin="0,0,4,0"
                                                                Padding="6,0"
                                                                Command="{Binding BandWidthZoomOutCommand}"
                                                                Focusable="False"
                                                                ToolTip="取值范围 ÷2（收窄，便于当前带宽微调）"><TextBlock FontSize="10" Text="÷2" /></Button>
                                                            <Button
                                                                Height="18"
                                                                Padding="6,0"
                                                                Command="{Binding BandWidthZoomInCommand}"
                                                                Focusable="False"
                                                                ToolTip="取值范围 ×2（放大）"><TextBlock FontSize="10" Text="×2" /></Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                                <!--  分割线：把全局带宽与骨点列表视觉分离  -->
                                                <Border
                                                    Height="1"
                                                    Margin="0,6,0,6"
                                                    Background="{StaticResource Brush.Bg.Hover}" />
                                                <!--  骨点列表标题  -->
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    FontSize="10"
                                                    Foreground="{StaticResource Brush.Text.Muted}"
                                                    Text="顶点带宽" />
                                                <ItemsControl ItemsSource="{Binding SelectedItem.VertexBandWidths}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2,0,6">
                                                                <!--  骨点 i 作为可点击组标题：点击切选中态（高亮下面两个 Slider 的左 3px 边框）  -->
                                                                <Border
                                                                    Margin="0,0,0,4"
                                                                    Padding="4,2"
                                                                    Background="{StaticResource Brush.Bg.Transparent}"
                                                                    CornerRadius="2"
                                                                    Cursor="Hand">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource Brush.Bg.Transparent}" />
                                                                            <Style.Triggers>
                                                                                <!--  选中态：组标题底色加深  -->
                                                                                <DataTrigger Value="True">
                                                                                    <DataTrigger.Binding>
                                                                                        <MultiBinding Converter="{StaticResource IntEquals}">
                                                                                            <Binding Path="Index" />
                                                                                            <Binding Path="DataContext.SelectedBonePointIndex" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                        </MultiBinding>
                                                                                    </DataTrigger.Binding>
                                                                                    <Setter Property="Background" Value="{StaticResource Brush.Bg.SuccessSoft}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Border.InputBindings>
                                                                        <MouseBinding
                                                                            Command="{Binding DataContext.ToggleBonePointSelectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding Index}"
                                                                            MouseAction="LeftClick" />
                                                                    </Border.InputBindings>
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{StaticResource Brush.Text.Hint}">
                                                                        <Run Text="骨点 " /><Run Text="{Binding Index, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </Border>
                                                                <!--
                                                                    入端（缩进 18，左对齐基线对齐 '入端' 字宽形成树状视觉）。
                                                                    首顶点（IsStart）没有前段，隐藏；
                                                                    合并模式（CollinearSplitPairs=false）下共线直通接缝顶点也只有出端，入端隐藏。
                                                                    Slider 包裹 Border：选中态时左边 3px 青边框凸出。
                                                                -->
                                                                <StackPanel Margin="18,0,0,3">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowIncoming}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="18" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <!--  入端：尖朝上三角形图标（替代文字"入端"）  -->
                                                                        <Path
                                                                            Grid.Column="0"
                                                                            Width="10"
                                                                            Height="7"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center"
                                                                            Data="M0,7 L10,7 L5,0 Z"
                                                                            Fill="{StaticResource Brush.Brand.Hint}"
                                                                            Stretch="Fill"
                                                                            ToolTip="入端：该骨点作为前一段末端时的带宽" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="10"
                                                                            Foreground="{StaticResource Brush.Text.Tertiary}">
                                                                            <Run Text="{Binding IncomingBandWidth, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                                                            <Run Text=" / " />
                                                                            <Run Text="{Binding DataContext.SelectedBandWidthMax, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat=F0}" />
                                                                        </TextBlock>
                                                                    </Grid>
                                                                    <Border Padding="0">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Bg.Transparent}" />
                                                                                <Setter Property="BorderThickness" Value="0,0,0,0" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Value="True">
                                                                                        <DataTrigger.Binding>
                                                                                            <MultiBinding Converter="{StaticResource IntEquals}">
                                                                                                <Binding Path="Index" />
                                                                                                <Binding Path="DataContext.SelectedBonePointIndex" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                            </MultiBinding>
                                                                                        </DataTrigger.Binding>
                                                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Port.Output2}" />
                                                                                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <controls:SliderSpinBox
                                                                            LargeChange="1"
                                                                            Maximum="{Binding DataContext.SelectedBandWidthMax, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay, FallbackValue=30}"
                                                                            Minimum="0"
                                                                            Step="0.1"
                                                                            StringFormat="{}{0:0.#}"
                                                                            Value="{Binding IncomingBandWidth, Mode=TwoWay}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <!--
                                                                    出端（缩进 18）。末顶点（IsEnd）没有后段，隐藏；合并模式下仍显示（中间点只有出端）。
                                                                    同入端：选中态左边 3px 青边框。
                                                                -->
                                                                <StackPanel Margin="18,0,0,0">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowOutgoing}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="18" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <!--  出端：尖朝下三角形图标（替代文字"出端"）  -->
                                                                        <Path
                                                                            Grid.Column="0"
                                                                            Width="10"
                                                                            Height="7"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center"
                                                                            Data="M0,0 L10,0 L5,7 Z"
                                                                            Fill="{StaticResource Brush.Brand.Hint}"
                                                                            Stretch="Fill"
                                                                            ToolTip="出端：该骨点作为后一段首端时的带宽" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="10"
                                                                            Foreground="{StaticResource Brush.Text.Tertiary}">
                                                                            <Run Text="{Binding OutgoingBandWidth, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                                                            <Run Text=" / " />
                                                                            <Run Text="{Binding DataContext.SelectedBandWidthMax, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat=F0}" />
                                                                        </TextBlock>
                                                                    </Grid>
                                                                    <Border Padding="0">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Bg.Transparent}" />
                                                                                <Setter Property="BorderThickness" Value="0,0,0,0" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Value="True">
                                                                                        <DataTrigger.Binding>
                                                                                            <MultiBinding Converter="{StaticResource IntEquals}">
                                                                                                <Binding Path="Index" />
                                                                                                <Binding Path="DataContext.SelectedBonePointIndex" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                            </MultiBinding>
                                                                                        </DataTrigger.Binding>
                                                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Port.Output2}" />
                                                                                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <controls:SliderSpinBox
                                                                            LargeChange="1"
                                                                            Maximum="{Binding DataContext.SelectedBandWidthMax, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay, FallbackValue=30}"
                                                                            Minimum="0"
                                                                            Step="0.1"
                                                                            StringFormat="{}{0:0.#}"
                                                                            Value="{Binding OutgoingBandWidth, Mode=TwoWay}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!--  轮廓模式：转角样式 + Round 内径 + 共线拆分 + 一键圆角 + 接缝编辑  -->
                                            <StackPanel Visibility="{Binding IsOutlineEditMode, Converter={StaticResource BoolToVis}}">
                                                <!--  转角连接方式（OutlineJoinStyle）：Miter 尖角 / Bevel 斜切 / Round 圆角  -->
                                                <StackPanel Margin="0,6,0,2">
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Primary}"
                                                            Text="转角样式" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Tertiary}"
                                                            Text="{Binding SelectedItem.OutlineJoinStyle, Mode=OneWay}" />
                                                    </Grid>
                                                    <ComboBox
                                                        Margin="0,0,0,0"
                                                        Background="{StaticResource Brush.Bg.InputDeep}"
                                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                        FontSize="11"
                                                        Foreground="{StaticResource Brush.Text.Primary}"
                                                        SelectedItem="{Binding SelectedItem.OutlineJoinStyle, Mode=TwoWay}">
                                                        <models:JoinStyle>Miter</models:JoinStyle>
                                                        <models:JoinStyle>Bevel</models:JoinStyle>
                                                        <models:JoinStyle>Round</models:JoinStyle>
                                                    </ComboBox>
                                                    <!--  Round join 内径 Slider（仅 Round 模式可见）：0 = 经典无内径弧  -->
                                                    <StackPanel x:Name="RoundJoinInnerPanel" Margin="0,6,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedItem.OutlineJoinStyle}" Value="{x:Static models:JoinStyle.Round}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <ItemsControl ItemsSource="{Binding SelectedItem.VertexBandWidths}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,4,0,0" Visibility="{Binding IsEnd, Converter={StaticResource InverseBoolToVis}}">
                                                                        <Grid Margin="0,0,0,2">
                                                                            <TextBlock
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="10"
                                                                                Foreground="{StaticResource Brush.Text.Primary}">
                                                                                <Run Text="顶点 " /><Run Text="{Binding Index, Mode=OneWay}" />
                                                                                <Run Text=" Round 内径" />
                                                                            </TextBlock>
                                                                            <TextBlock
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="10"
                                                                                Foreground="{StaticResource Brush.Text.Tertiary}"
                                                                                Text="{Binding JoinInnerRadius, Mode=OneWay, StringFormat=F1}" />
                                                                        </Grid>
                                                                        <controls:SliderSpinBox
                                                                            LargeChange="1"
                                                                            Maximum="20"
                                                                            Minimum="0"
                                                                            Step="0.1"
                                                                            StringFormat="{}{0:0.#}"
                                                                            Value="{Binding JoinInnerRadius, Mode=TwoWay}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!--  非转角点样式：Round = 一键圆角（半径可调），Miter = 恢复尖角  -->
                                                <StackPanel Margin="0,16,0,6">
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Primary}"
                                                            Text="非转角点样式" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Tertiary}"
                                                            Text="{Binding CornerArcRadius, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                                    </Grid>
                                                    <ComboBox
                                                        Margin="0,0,0,6"
                                                        Background="{StaticResource Brush.Bg.InputDeep}"
                                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                        FontSize="11"
                                                        Foreground="{StaticResource Brush.Text.Primary}"
                                                        SelectedItem="{Binding NonCornerStyle, Mode=TwoWay}">
                                                        <models:JoinStyle>Round</models:JoinStyle>
                                                        <models:JoinStyle>Miter</models:JoinStyle>
                                                    </ComboBox>
                                                    <!--  圆角半径 Slider：仅 Round 时显示（Miter 不需要半径）  -->
                                                    <StackPanel Margin="0,0,0,8">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NonCornerStyle}" Value="{x:Static models:JoinStyle.Round}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <controls:SliderSpinBox
                                                            IsSnapToTickEnabled="True"
                                                            Maximum="{Binding CornerArcRadiusMax, Mode=OneWay}"
                                                            Minimum="0.5"
                                                            Step="1"
                                                            StringFormat="{}{0:0.#}"
                                                            Value="{Binding CornerArcRadius, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <Border
                                                        Padding="6,4"
                                                        Background="{StaticResource Brush.Bg.Darker}"
                                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="OnApplyRoundToAllClick">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.State.SuccessLight}"
                                                            Text="应用到全部接缝" />
                                                    </Border>
                                                </StackPanel>

                                                <!--  轮廓编辑模式：接缝属性面板（始终可见；未选中时 SelectedOutlineCorner=null，控件空绑定）  -->
                                                <StackPanel Margin="0,16,0,6">
                                                    <TextBlock
                                                        Margin="0,0,0,8"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource Brush.Text.Muted}"
                                                        Text="接缝编辑" />
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Primary}">
                                                            <Run Text="顶点 " />
                                                            <Run Text="{Binding SelectedOutlineCorner.Index, Mode=OneWay, TargetNullValue='-'}" />
                                                            <Run Text=" (" />
                                                            <Run Text="{Binding SelectedOutlineCorner.Side, Mode=OneWay, TargetNullValue='-'}" />
                                                            <Run Text=")" />
                                                        </TextBlock>
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Tertiary}"
                                                            Text="{Binding SelectedOutlineCorner.CurrentStyleEffective, Mode=OneWay, TargetNullValue='-'}" />
                                                    </Grid>
                                                    <!--
                                                        接缝样式 ComboBox：绑 CurrentStyleEffective（非 nullable；null 继承全局已解析）。
                                                        TwoWay 写时 OutlineCornerHandle.SetCurrentStyle 会走 VM 写流程
                                                        （per-vertex override + NotifyOutlineGeometryChanged + Refresh）。
                                                        BandPolyline / 闭合 Polyline / BooleanPath 统一三态（布尔无带宽，Bevel 视同尖角）。
                                                    -->
                                                    <ComboBox
                                                        Background="{StaticResource Brush.Bg.InputDeep}"
                                                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                                                        FontSize="11"
                                                        Foreground="{StaticResource Brush.Text.Primary}"
                                                        IsEnabled="{Binding HasSelectedOutlineCorner}"
                                                        SelectedItem="{Binding SelectedOutlineCorner.CurrentStyleEffective, Mode=TwoWay}">
                                                        <models:JoinStyle>Miter</models:JoinStyle>
                                                        <models:JoinStyle>Bevel</models:JoinStyle>
                                                        <models:JoinStyle>Round</models:JoinStyle>
                                                    </ComboBox>
                                                    <!--
                                                        圆角半径：值取自选中接缝手柄的 CurrentRadius（按 IsCorner/Side 自动路由到顶点带宽对应字段），
                                                        写入通过 ValueChanged 事件调手柄 SetRadius → VM 写 VertexFields + 刷 OutlineGeometry。
                                                        未选接缝时控件禁用。
                                                    -->
                                                    <Grid Margin="0,4,0,4">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Primary}"
                                                            Text="圆角半径" />
                                                        <Slider
                                                            x:Name="CornerRadiusSlider"
                                                            Width="90"
                                                            Margin="60,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            IsSnapToTickEnabled="True"
                                                            Maximum="200"
                                                            Minimum="0"
                                                            TickFrequency="1"
                                                            ValueChanged="OnCornerRadiusSliderValueChanged">
                                                            <Slider.Style>
                                                                <Style TargetType="Slider">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding HasSelectedOutlineCorner}" Value="True" />
                                                                                <Condition Binding="{Binding SelectedOutlineCorner.CurrentStyleEffective}" Value="{x:Static models:JoinStyle.Round}" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="IsEnabled" Value="True" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Slider.Style>
                                                        </Slider>
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Brush.Text.Tertiary}"
                                                            Text="{Binding SelectedOutlineCorner.CurrentRadius, Mode=OneWay, StringFormat={}{0:0.#}, TargetNullValue=-}" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!--  ═══ 元素页：全量元素清单 + 隐藏/显示控制（用于排查画布上不可见的多余元素） ═══  -->
                        <Grid Visibility="{Binding IsElementsPaneVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  统计条：总数 + 隐藏数徽标 + 全部显示按钮  -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{StaticResource Brush.Text.Muted}">
                                        <Run Text="共 " /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" 个元素" />
                                    </TextBlock>
                                    <!--  隐藏数徽标（无隐藏元素时不显示）  -->
                                    <Border
                                        Margin="6,0,0,0"
                                        Padding="4,1"
                                        Background="{StaticResource Brush.Bg.DangerSoft}"
                                        BorderBrush="{StaticResource Brush.Border.Danger}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Visibility="{Binding HasHiddenElements, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="10" Foreground="{StaticResource Brush.State.DangerLight}">
                                            <Run Text="已隐藏 " /><Run Text="{Binding HiddenCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <!--  全部显示：仅当存在隐藏元素时可点（恢复排查前的状态）  -->
                                <Border
                                    Padding="8,3"
                                    HorizontalAlignment="Right"
                                    Background="{StaticResource Brush.Bg.Success}"
                                    BorderBrush="{StaticResource Brush.Border.Success}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Cursor="Hand"
                                    IsEnabled="{Binding HasHiddenElements}"
                                    ToolTip="把所有隐藏元素恢复可见">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0.35" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasHiddenElements}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding Command="{Binding ShowAllElementsCommand}" MouseAction="LeftClick" />
                                    </Border.InputBindings>
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{StaticResource Brush.State.SuccessLight}"
                                        Text="全部显示" />
                                </Border>
                            </Grid>

                            <!--
                                元素清单：每行一个元素。勾选控制隐藏/显示；点击行选中画布元素（与画布双向联动）。
                                隐藏行显示红色"已隐藏"徽标，方便一眼找出不可见的多余元素。
                            -->
                            <ListBox
                                Grid.Row="1"
                                Background="{StaticResource Brush.Bg.Transparent}"
                                BorderThickness="0"
                                ItemsSource="{Binding Primitives}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="{StaticResource Brush.Bg.Transparent}" />
                                        <Setter Property="Padding" Value="2" />
                                        <Setter Property="Margin" Value="0,0,0,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Bg.SelectedAlt}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Bg.SuccessSoft}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!--
                                                可见性切换：睁眼 / 闭眼图标按钮。
                                                睁眼：Segoe MDL2 Assets E7B3（View，确认存在的字符）。
                                                闭眼：PathGeometry 画弧线（不依赖字符集；EED1 在部分字体环境下缺字符显示为 □）。
                                                点击切换 IsVisible（绕开 ListBoxItem 选中联动，由 ToggleElementVisibleCommand 显式翻值）。
                                            -->
                                            <Border
                                                Grid.Column="0"
                                                Width="22"
                                                Height="22"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                CornerRadius="3"
                                                Cursor="Hand"
                                                ToolTip="点击切换显示/隐藏">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Bg.Transparent}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Bg.SuccessSub}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.SuccessSoft}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Bg.DangerSoft}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Danger}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding
                                                        Command="{Binding DataContext.ToggleElementVisibleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        MouseAction="LeftClick" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <!--
                                                        睁眼：PathGeometry 画的眼睛轮廓 + 瞳孔（来自 YwMes.LoginDialogView eyeIcon）。
                                                        不依赖 Segoe MDL2 Assets 字符，跨环境稳定渲染。
                                                        重要：不能写本地 Visibility 属性，否则会压制 Style.Trigger（本地值优先级 > Style）。
                                                    -->
                                                    <Path
                                                        x:Name="eyeOpenIcon"
                                                        Width="14"
                                                        Height="14"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="M8,3 C4.667,3 1.992,5.4 1,8.5 C1.992,11.6 4.667,14 8,14 C11.333,14 14.008,11.6 15,8.5 C14.008,5.4 11.333,3 8,3 Z M8,11.5 A3,3 0 0,1 5,8.5 A3,3 0 0,1 8,5.5 A3,3 0 0,1 11,8.5 A3,3 0 0,1 8,11.5 Z"
                                                        Fill="{StaticResource Brush.Bg.Transparent}"
                                                        Stretch="Uniform"
                                                        Stroke="{StaticResource Brush.State.SuccessBorder}"
                                                        StrokeThickness="1.4">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <!--
                                                        闭眼：睁眼轮廓 + 斜杠划线（来自 YwMes.LoginDialogView eyeSlashIcon）。
                                                        不能写本地 Visibility="Collapsed"（否则压制 Trigger）。默认可见态由 Style.Setter = Collapsed 提供。
                                                    -->
                                                    <Path
                                                        x:Name="eyeClosedIcon"
                                                        Width="14"
                                                        Height="14"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="M2,8.5 C2.992,5.4 5.667,3 9,3 C12.333,3 15.008,5.4 16,8.5 C15.008,11.6 12.333,14 9,14 C5.667,14 2.992,11.6 2,8.5 Z M5,8.5 A4,4 0 0,0 13,8.5 M4,4 L12,12"
                                                        Fill="{StaticResource Brush.Bg.Transparent}"
                                                        Stretch="Uniform"
                                                        Stroke="{StaticResource Brush.State.DangerLight}"
                                                        StrokeThickness="1.4">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <!--
                                                第三列：快速定位按钮（左侧，蓝色 E81E 准星）+ 删除按钮（右侧，红色 E74D 垃圾桶）。
                                                横向 StackPanel 排列。两个按钮 MouseBinding 都走 Read 的 SelectedItem。
                                            -->
                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <!--  快速定位：选中元素 + 通知 VM 跳转视口到该元素中心（View 端订阅 RequestLocate 调 ZoomPan）  -->
                                                <Border
                                                    Width="22"
                                                    Height="22"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource Brush.Bg.Selected}"
                                                    BorderBrush="{StaticResource Brush.Border.AccentDeep}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Cursor="Hand"
                                                    ToolTip="快速定位到该元素">
                                                    <Border.InputBindings>
                                                        <MouseBinding
                                                            Command="{Binding DataContext.LocateElementCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            MouseAction="LeftClick" />
                                                    </Border.InputBindings>
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="14"
                                                        Foreground="{StaticResource Brush.Port.Input3}"
                                                        Text="&#xE81E;" />
                                                </Border>
                                                <!--  删除该元素  -->
                                                <Border
                                                    Width="22"
                                                    Height="22"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource Brush.Bg.Danger}"
                                                    BorderBrush="{StaticResource Brush.Border.DangerDeep}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Cursor="Hand"
                                                    ToolTip="删除该元素">
                                                    <Border.InputBindings>
                                                        <MouseBinding
                                                            Command="{Binding DataContext.DeleteElementCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            MouseAction="LeftClick" />
                                                    </Border.InputBindings>
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="14"
                                                        Foreground="{StaticResource Brush.State.Danger}"
                                                        Text="&#xE74D;" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource Brush.Text.Hint}"
                                                        Text="{Binding TypeKey}" />
                                                    <Border
                                                        Margin="6,0,0,0"
                                                        Padding="4,0"
                                                        Background="{StaticResource Brush.Bg.DangerSoft}"
                                                        BorderBrush="{StaticResource Brush.Border.Danger}"
                                                        BorderThickness="1"
                                                        CornerRadius="2"
                                                        Visibility="{Binding IsVisible, Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock
                                                            FontSize="9"
                                                            Foreground="{StaticResource Brush.State.DangerLight}"
                                                            Text="已隐藏" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    Margin="0,1,0,0"
                                                    FontSize="9"
                                                    Foreground="{StaticResource Brush.Text.Tertiary}"
                                                    Text="{Binding PositionInfo}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  XAML 导出弹窗：覆盖在最上层，半透明遮罩  -->
        <Grid Grid.ColumnSpan="3" Visibility="{Binding IsExportDialogOpen, Converter={StaticResource BoolToVis}}">
            <!--  半透明遮罩：点击关闭弹窗  -->
            <Rectangle Fill="{StaticResource Brush.Overlay.Dim}" MouseLeftButtonDown="OnExportDialogCloseClick" />

            <!--  弹窗主体  -->
            <Border
                Width="640"
                MaxHeight="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Brush.Bg.Deep}"
                BorderBrush="{StaticResource Brush.State.Accent}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题栏  -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource Brush.Text.Primary}"
                            Text="导出画布 XAML" />
                        <Border
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            Background="{StaticResource Brush.Bg.Raised}"
                            BorderBrush="{StaticResource Brush.Border.AccentBlue}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Cursor="Hand"
                            MouseLeftButtonDown="OnExportDialogCloseClick">
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource Brush.Text.Primary}"
                                Text="✕ 关闭" />
                        </Border>
                    </Grid>

                    <!--  XAML 内容（只读 TextBox，可全选复制）  -->
                    <Border
                        Grid.Row="1"
                        Background="{StaticResource Brush.Bg.Input}"
                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBox
                            x:Name="ExportTextBox"
                            Padding="8"
                            AcceptsReturn="True"
                            Background="{StaticResource Brush.Bg.Transparent}"
                            BorderThickness="0"
                            FontFamily="Consolas, Courier New"
                            FontSize="11"
                            Foreground="{StaticResource Brush.Text.Secondary}"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            Text="{Binding ExportedXaml, Mode=OneWay}"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>

                    <!--  操作按钮  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Border
                            Margin="0,0,6,0"
                            Padding="12,5"
                            Background="{StaticResource Brush.Bg.Success}"
                            BorderBrush="{StaticResource Brush.Border.Success}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Cursor="Hand"
                            MouseLeftButtonDown="OnCopyXamlClick">
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource Brush.State.SuccessLight}"
                                Text="📋 复制到剪贴板" />
                        </Border>
                        <Border
                            Padding="12,5"
                            Background="{StaticResource Brush.Bg.Selected}"
                            BorderBrush="{StaticResource Brush.Border.Mid}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Cursor="Hand"
                            MouseLeftButtonDown="OnSaveXamlClick">
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource Brush.Text.Primary}"
                                Text="💾 另存为 .xaml…" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  旧的全屏沿路径阵列弹窗已移除：功能由画布右上角"预览浮层"（IsPathArrayPreviewOpen）取代  -->
    </Grid>
</UserControl>