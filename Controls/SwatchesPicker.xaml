<UserControl x:Class="SymbolDesigner.Controls.SwatchesPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <!-- 触发块：色块预览 + hex + 下拉箭头。
             ToggleButton + IsChecked 绑 Popup.IsOpen；Window 级 PreviewMouseDown 判定外部点击关闭。 -->
        <Grid>
            <ToggleButton x:Name="MainButton" Margin="0,1" Padding="0" Cursor="Hand"
                          IsChecked="{Binding ElementName=Popup, Path=IsOpen, Mode=TwoWay}"
                          Checked="OnMainChecked"
                          Unchecked="OnMainUnchecked"
                          PreviewMouseLeftButtonDown="OnMainPreviewDown"
                          PreviewMouseLeftButtonUp="OnMainPreviewUp">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Margin="0" Padding="4,3" CornerRadius="3"
                                Background="#1A2A3A" BorderBrush="#3A5A7A" BorderThickness="1" />
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Grid Margin="0,1" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ColorPreview" Grid.Column="0" Width="20" Height="14" CornerRadius="2"
                        Margin="4,3" BorderBrush="#2A3A4A" BorderThickness="1" />
                <TextBlock x:Name="HexText" Grid.Column="1" Margin="5,0,4,0" FontSize="10"
                           VerticalAlignment="Center" Text="(空)" />
                <TextBlock Grid.Column="2" FontSize="8" VerticalAlignment="Center" Text="▼" Margin="0,0,4,0" />
            </Grid>
        </Grid>

        <!-- 弹出取色面板：4 区域（最近使用 / 主矩阵 / 标准颜色 / 快捷按钮）。
             StaysOpen="True"：外部点击关闭由本控件在 Window 级 PreviewMouseDown 自行判定。 -->
        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=MainButton}" Placement="Bottom"
               StaysOpen="True" AllowsTransparency="True" HorizontalOffset="-130">
            <Border Margin="2" Padding="6" CornerRadius="4" Width="200"
                    Background="{StaticResource Brush.Bg.Popup}"
                    BorderBrush="{StaticResource Brush.Border.Mid}" BorderThickness="1">
                <StackPanel>
                    <!-- 最近使用颜色：固定 10 个槽位 Border（始终占位），RecentColors 集合变化时由
             code-behind 同步把前 N 个填实色，剩余保持虚线占位。
             与 ItemsControl 不同：ItemsControl 空集合时整行高度=0，看不到"行"的概念；
             这里固定 10 个 Border（Height=16，Width=16，Margin=1），保证 0 色时也有占位框。 -->
                    <StackPanel>
                        <TextBlock Text="最近使用颜色" FontSize="9"
                                   Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,3" />
                        <UniformGrid x:Name="RecentSlots" Rows="1" Columns="10" />
                    </StackPanel>

                    <!-- 主矩阵：9 列 × 8 行（左上第 1 格透明 = 无填充） -->
                    <StackPanel Margin="0,6,0,0">
                        <UniformGrid x:Name="MainSwatchGrid" Columns="9" Rows="8" />
                    </StackPanel>

                    <!-- 分隔 -->
                    <Border Margin="0,6,0,4" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" />

                    <!-- 标准颜色：1 行 10 色 -->
                    <StackPanel>
                        <TextBlock Text="标准颜色" FontSize="9"
                                   Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,0,3" />
                        <UniformGrid x:Name="StandardGrid" Columns="10" Rows="1" />
                    </StackPanel>

                    <!-- 分隔 -->
                    <Border Margin="0,6,0,4" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" />

                    <!-- 快捷按钮：更多颜色 / 取色器 / 无填充 -->
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="更多颜色" FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Primary}" />
                            <Button Grid.Column="1" Click="OnMoreColorsClick" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="2">
                                <Border Width="14" Height="14" CornerRadius="1"
                                        Background="{StaticResource Brush.Bg.Canvas}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0.6">
                                    <Border Width="10" Height="6" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{StaticResource Brush.Palette.Spectrum}" />
                                </Border>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="取色器" FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Primary}" />
                            <Button Grid.Column="1" Click="OnEyedropperClick" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="2">
                                <TextBlock Text="🖊" FontSize="14"
                                           Foreground="{StaticResource Brush.Text.Primary}" />
                            </Button>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="无填充" FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Primary}" />
                            <Button Grid.Column="1" Click="OnNoFillClick" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="2">
                                <Border Width="14" Height="14" CornerRadius="1"
                                        Background="{StaticResource Brush.Bg.Canvas}"
                                        BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0.6">
                                    <Path Stroke="{StaticResource Brush.State.Danger}" StrokeThickness="1.2"
                                          Stretch="Uniform"
                                          Data="M 0,1 L 1,0" />
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 分隔 -->
                    <Border Margin="0,6,0,4" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" />

                    <!-- HEX 手动输入 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="HEX:" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Muted}" />
                        <TextBox x:Name="HexInput" Width="148" Margin="4,0,0,0" FontSize="10"
                                 Background="{StaticResource Brush.Bg.Input}"
                                 Foreground="{StaticResource Brush.Text.Primary}"
                                 BorderBrush="{StaticResource Brush.Border.Mid}"
                                 BorderThickness="1" Padding="2,1"
                                 TextChanged="OnHexTextChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>